#!/usr/bin/env bash
#
# llmstack — pile LLM 100 % locale
#   llama.cpp  : bare metal (ton utilisateur), MODE ROUTEUR : un seul llama-server qui charge/décharge les
#                modèles à la demande (socket unix). Variantes de réglage (effort de raisonnement, ctx…) par modèle.
#   Open WebUI : conteneur podman rootless durci
#   SearXNG    : conteneur podman rootless durci
#   relais     : conteneur socat (réseau interne) : pont réseau interne → socket du routeur
#   opencode   : bare metal, utilisateur dédié (ou le tien) + sandbox bubblewrap, travaille sur une COPIE du
#                projet ; les changements reviennent après relecture (diff) — « llmstack setup-agent » d'abord
#   Réseau     : réseau podman interne (sans Internet) + réseau « front » pour les services qui en ont besoin
#
# Respecte XDG :
#   config  $XDG_CONFIG_HOME/llmstack   (stack.env, secrets.env, models.d/, searxng/, opencode.json optionnel)
#   données $XDG_DATA_HOME/llmstack     (bin/, llama.cpp/, models/, webui/, agent-* en mode « self »)
#   état    $XDG_STATE_HOME/llmstack    (run/*.pid, log/*.log, models-preset.ini, code/)
#   cache   $XDG_CACHE_HOME/llmstack
#   socket  /tmp/llmstack-<uid>/        (dossier 711 : traversable par l'utilisateur de l'agent)
#
set -Eeuo pipefail
shopt -s nullglob

PROG=${0##*/}
VERSION=3.4.0
WRAPPER_VERSION=2

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "$PROG: bash >= 4.4 requis" >&2
  exit 1
fi

# ───────────────────────────── Affichage ─────────────────────────────
if [[ -t 1 ]]; then
  C_B=$'\e[1;34m' C_G=$'\e[32m' C_Y=$'\e[33m' C_R=$'\e[31m' C_0=$'\e[0m'
else
  C_B='' C_G='' C_Y='' C_R='' C_0=''
fi
info() { printf '%s==>%s %s\n' "$C_B" "$C_0" "$*"; }
ok()   { printf '%s ✓%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '%s !%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
die()  { printf '%serreur :%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }
need() { local c; for c in "$@"; do command -v "$c" >/dev/null 2>&1 || die "commande requise introuvable : $c"; done; }

ASSUME_YES=0
confirm() {
  if (( ASSUME_YES )); then return 0; fi
  [[ -t 0 ]] || die "confirmation requise : relance avec -y"
  local a; read -r -p "$1 [o/N] " a
  [[ $a =~ ^[oOyY] ]]
}

safe_rm() {
  local p
  for p in "$@"; do
    [[ -n $p && $p != / && $p != "$HOME" && $p == /*/* ]] || die "refus de supprimer '$p'"
    rm -rf -- "$p"
  done
}

rand_hex() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }

# ───────────────────────────── Configuration ─────────────────────────────
SERVICES=(searxng llama webui)

load_config() {
  local xc=${XDG_CONFIG_HOME:-$HOME/.config} xd=${XDG_DATA_HOME:-$HOME/.local/share}
  local xs=${XDG_STATE_HOME:-$HOME/.local/state} xk=${XDG_CACHE_HOME:-$HOME/.cache}
  CONF_DIR=$xc/llmstack DATA_DIR=$xd/llmstack STATE_DIR=$xs/llmstack CACHE_DIR=$xk/llmstack
  PATH="${XDG_BIN_HOME:-$HOME/.local/bin}:$PATH"

  # Défauts (surchargeables par l'environnement ou par stack.env)
  : "${BIND_HOST:=127.0.0.1}"
  : "${WEBUI_PORT:=8080}"
  : "${SEARXNG_PORT:=8888}"
  : "${LLAMA_PORT:=8081}"              # port du relais (réseau interne) → routeur llama
  : "${ENABLE_SEARXNG:=1}"
  : "${LLAMA_REPO:=https://github.com/ggml-org/llama.cpp}"
  : "${LLAMA_REF:=master}"
  : "${LLAMA_BACKEND:=auto}"           # auto|cuda|hip|vulkan|metal|cpu
  : "${LLAMA_CMAKE_ARGS:=}"
  # Routeur : combien de modèles chargés en même temps (1 = le précédent est déchargé automatiquement)
  : "${MODELS_MAX:=1}"
  : "${MODELS_MEMORY_MARGIN:=0}"       # MiB de VRAM à garder libres (0 = désactivé) ; alternative à MODELS_MAX
  : "${IDLE_UNLOAD_SECONDS:=0}"        # > 0 : modèle mis en veille après N s d'inactivité
  : "${LLAMA_ROUTER_ARGS:=}"           # arguments supplémentaires du routeur
  : "${LLAMA_PARALLEL:=1}"             # conversations simultanées par modèle (1 = moins de mémoire réservée)
  # Images : épingle des versions/digests dans stack.env (les défauts sont flottants)
  : "${WEBUI_IMAGE:=ghcr.io/open-webui/open-webui:main}"
  : "${SEARXNG_IMAGE:=docker.io/searxng/searxng:latest}"
  : "${RELAY_IMAGE:=docker.io/alpine/socat:latest}"
  : "${SEARXNG_CONTAINER:=llmstack-searxng}"
  CT_WEBUI=llmstack-webui CT_RELAY=llmstack-relay
  : "${NET_BACK:=llmstack-back}"       # réseau interne (--internal) : aucun accès Internet
  : "${NET_FRONT:=llmstack-front}"     # réseau avec sortie : Open WebUI, SearXNG
  : "${SERVICE_UID:=60001}"            # Open WebUI, relais : mappé sur un subuid
  : "${SEARXNG_USERNS:=keep-id:uid=977,gid=977}"
  # Durcissement
  : "${WEBUI_ENABLE_SIGNUP:=True}"
  : "${WEBUI_REQUEST_TIMEOUT:=1800}"   # s ; le chargement d'un gros modèle peut être long
  : "${TMP_SIZE:=1g}"
  : "${WEBUI_MEMORY:=4g}" "${SEARXNG_MEMORY:=1g}" "${RELAY_MEMORY:=128m}"
  : "${WEBUI_PIDS:=1024}" "${SEARXNG_PIDS:=256}"
  : "${WEBUI_PODMAN_ARGS:=}" "${SEARXNG_PODMAN_ARGS:=}" "${RELAY_PODMAN_ARGS:=}"
  : "${DEFAULT_CTX:=8192}"
  : "${DEFAULT_QUANT:=Q4_K_M}"
  : "${HF_ENDPOINT:=https://huggingface.co}"
  # Agent opencode
  : "${AGENT_MODE:=}"                  # user | self — posé par « setup-agent »
  : "${AGENT_USER:=llmagent}"
  : "${AGENT_SANDBOX:=bwrap}"          # bwrap | none
  : "${AGENT_NET:=1}"                  # 1 : l'agent a Internet (et voit les services locaux 127.0.0.1) ; 0 : réseau coupé
  : "${AGENT_LLM_PORT:=18080}"         # port local, DANS le sandbox, du pont vers le routeur
  : "${AGENT_NEW_SESSION:=1}"          # bwrap --new-session (désactive si le TUI se comporte mal)
  : "${OPENCODE_VERSION:=latest}"
  : "${MCP_SEARXNG_VERSION:=latest}"   # serveur MCP qui donne à opencode la recherche web via SearXNG
  : "${CODE_EXCLUDES:=.env .env.* *.pem *.key *.p12 id_rsa* id_ed25519* .ssh .aws .gnupg .netrc .npmrc .pypirc node_modules .venv venv __pycache__ target}"
  : "${CODE_COPY_GIT:=1}"              # copie .git dans le workspace (sans hooks ni config)
  : "${CODE_MAX_COPY_MB:=2000}"

  if [[ -f $CONF_DIR/stack.env ]]; then
    # shellcheck disable=SC1091
    source "$CONF_DIR/stack.env"
  fi

  : "${MODELS_DIR:=$CACHE_DIR/models}"
  BIN_DIR=$DATA_DIR/bin SRC_DIR=$DATA_DIR/llama.cpp
  RUN_DIR=$STATE_DIR/run LOG_DIR=$STATE_DIR/log MODELS_CONF=$CONF_DIR/models.d
  # Socket du routeur : dossier 711 (traversable), socket en 666 (le relais rootless et l'agent y accèdent)
  SOCK_DIR=${LLMSTACK_SOCK_DIR:-/tmp/llmstack-$(id -u)}
  LLAMA_SOCK=$SOCK_DIR/llama.sock
  PRESET_FILE=$STATE_DIR/models-preset.ini
  CODE_STATE=$STATE_DIR/code
  SUDOERS_FILE=/etc/sudoers.d/llmstack-agent
  agent_paths
}

agent_paths() {
  case ${AGENT_MODE:-} in
    user) AGENT_HOME=/var/lib/$AGENT_USER AGENT_BIN=/opt/llmstack-agent
          WRAPPER=/usr/local/libexec/llmstack-agent-run;;
    self) AGENT_HOME=$DATA_DIR/agent-home AGENT_BIN=$DATA_DIR/agent-sys
          WRAPPER=$AGENT_BIN/libexec/llmstack-agent-run;;
    *)    AGENT_HOME='' AGENT_BIN='' WRAPPER='';;
  esac
}

load_secrets() {
  local f=$CONF_DIR/secrets.env
  if [[ ! -f $f ]]; then
    mkdir -p "$CONF_DIR"
    ( umask 077
      {
        echo "WEBUI_SECRET_KEY=$(rand_hex 32)"
        echo "SEARXNG_SECRET=$(rand_hex 32)"
      } >"$f" )
  fi
  # shellcheck disable=SC1090
  source "$f"
  : "${WEBUI_SECRET_KEY:=$(rand_hex 32)}" "${SEARXNG_SECRET:=$(rand_hex 32)}"
}

ensure_dirs() {
  mkdir -p "$CONF_DIR" "$MODELS_CONF" "$CONF_DIR/searxng" \
           "$DATA_DIR" "$BIN_DIR" "$MODELS_DIR" \
           "$RUN_DIR" "$LOG_DIR" "$CACHE_DIR" "$CODE_STATE"
  if [[ ! -d $SOCK_DIR ]]; then mkdir -m 711 -- "$SOCK_DIR"; fi
  [[ -d $SOCK_DIR && ! -L $SOCK_DIR && -O $SOCK_DIR ]] || die "'$SOCK_DIR' n'est pas un dossier à toi (lien ou autre propriétaire) — change LLMSTACK_SOCK_DIR"
  chmod 711 "$SOCK_DIR"
}

load_all() { load_config; load_secrets; ensure_dirs; }

set_conf() { # KEY VALUE → persiste dans stack.env
  local k=$1 v=$2 f=$CONF_DIR/stack.env
  touch "$f"
  if grep -q "^$k=" "$f"; then
    sed -E -i.bak "s|^$k=.*|$k=$v|" "$f" && rm -f "$f.bak"
  else
    echo "$k=$v" >>"$f"
  fi
}
unset_conf() { local f=$CONF_DIR/stack.env; if [[ -f $f ]]; then sed -E -i.bak "/^$1=/d" "$f" && rm -f "$f.bak"; fi; }

svc_enabled() { [[ $1 != searxng || $ENABLE_SEARXNG == 1 ]]; }

# ───────────────────────────── Processus bare metal ─────────────────────────────
pid_of() { # id → pid si actif
  local pf=$RUN_DIR/$1.pid p
  if [[ -f $pf ]]; then
    p=$(<"$pf")
    if kill -0 "$p" 2>/dev/null; then echo "$p"; fi
  fi
}
is_running() { [[ -n $(pid_of "$1") ]]; }

spawn() { # id workdir cmd args...
  local id=$1 wd=$2 log=$LOG_DIR/$1.log; shift 2
  if is_running "$id"; then ok "$id déjà actif (pid $(pid_of "$id"))"; return 0; fi
  mkdir -p "$wd" "$RUN_DIR" "$LOG_DIR"
  if [[ -n $(find "$log" -size +10M 2>/dev/null) ]]; then mv -f "$log" "$log.1"; fi
  local ss=()
  if command -v setsid >/dev/null 2>&1; then ss=(setsid); fi
  ( cd "$wd" && exec "${ss[@]}" nohup env "$@" ) >>"$log" 2>&1 </dev/null &
  echo $! >"$RUN_DIR/$id.pid"
  sleep 1
  is_running "$id" || die "$id s'est arrêté immédiatement — voir : $PROG logs $id"
}

stop_proc() {
  local id=$1 pid i
  pid=$(pid_of "$id")
  if [[ -n $pid ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for i in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
    ok "$id arrêté"
  fi
  rm -f "$RUN_DIR/$id.pid"
}

# ───────────────────────────── Modèles ─────────────────────────────
# models.d/<nom>.env             : REPO FILE CTX NGL ENABLED EXTRA        (le modèle de base)
# models.d/<nom>.d/<variante>.env : V_CTX V_NGL V_EXTRA                    (réglages en plus, même fichier GGUF)
# → le routeur expose « <nom> » et « <nom>-<variante> » comme modèles distincts.
model_names() { local f; for f in "$MODELS_CONF"/*.env; do f=${f##*/}; echo "${f%.env}"; done; }

load_model() {
  REPO='' FILE='' CTX=$DEFAULT_CTX NGL='' ENABLED=1 EXTRA=''
  # shellcheck disable=SC1090
  source "$MODELS_CONF/$1.env"
}
load_variant() { # modèle variante
  V_CTX='' V_NGL='' V_EXTRA=''
  # shellcheck disable=SC1090
  source "$MODELS_CONF/$1.d/$2.env"
}
variant_names() { local f; for f in "$MODELS_CONF/$1.d"/*.env; do f=${f##*/}; echo "${f%.env}"; done; }

curl_hf() {
  local a=()
  if [[ -n ${HF_TOKEN:-} ]]; then a=(-H "Authorization: Bearer $HF_TOKEN"); fi
  curl "${a[@]}" "$@"
}

list_ggufs() { # repo → fichiers .gguf (hors mmproj)
  local json
  json=$(curl_hf -fsSL "$HF_ENDPOINT/api/models/$1") || die "dépôt HF introuvable ou privé (HF_TOKEN ?) : $1"
  { grep -oE '"rfilename" *: *"[^"]+\.gguf"' <<<"$json" || true; } \
    | sed -E 's/^"rfilename" *: *"(.*)"$/\1/' | { grep -vi mmproj || true; } | sort
}

RESOLVED=()
resolve_files() { # repo selector → RESOLVED[] (parts d'un GGUF éventuellement splitté)
  local repo=$1 sel=$2 all=() f bases
  mapfile -t all < <(list_ggufs "$repo")
  (( ${#all[@]} )) || die "aucun fichier GGUF dans $repo"
  RESOLVED=()
  for f in "${all[@]}"; do [[ $f == "$sel" ]] && RESOLVED+=("$f"); done
  if (( ${#RESOLVED[@]} == 0 )); then
    for f in "${all[@]}"; do [[ ${f,,} == *"${sel,,}"* ]] && RESOLVED+=("$f"); done
  fi
  if (( ${#RESOLVED[@]} == 0 )); then
    warn "aucun fichier ne correspond à '$sel'. Disponibles :"
    printf '   %s\n' "${all[@]}" >&2
    exit 1
  fi
  bases=$(printf '%s\n' "${RESOLVED[@]}" | sed -E 's/-[0-9]{5}-of-[0-9]{5}\.gguf$/.gguf/' | sort -u | wc -l)
  if (( bases > 1 )); then
    warn "'$sel' est ambigu, précise le fichier ou la quantisation :"
    printf '   %s\n' "${RESOLVED[@]}" >&2
    exit 1
  fi
}

download() { # url dest
  local url=$1 dest=$2 bar=(-s -S)
  [[ -f $dest ]] && { ok "déjà présent : ${dest##*/}"; return 0; }
  mkdir -p "${dest%/*}"
  if [[ -t 2 ]]; then bar=(--progress-bar); fi
  info "Téléchargement ${dest##*/}"
  curl_hf -fL -C - --retry 3 "${bar[@]}" -o "$dest.part" "$url"
  mv "$dest.part" "$dest"
}

write_model_conf() { # name repo file ctx ngl enabled extra
  {
    printf 'REPO=%q\n' "$2"; printf 'FILE=%q\n' "$3"
    printf 'CTX=%q\n' "$4";  printf 'NGL=%q\n' "$5";  printf 'ENABLED=%q\n' "$6"
    printf 'EXTRA=%q\n' "$7"
  } >"$MODELS_CONF/$1.env"
}

# « --a 1 --b --c x » → « a = 1 », « b = true », « c = x » (format des presets llama-server)
extra_to_ini() {
  local -a t=()
  local i k v
  read -r -a t <<<"$1"
  for (( i = 0; i < ${#t[@]}; i++ )); do
    k=${t[i]}
    if [[ $k != -* ]]; then warn "argument ignoré dans EXTRA (attendu --option) : $k"; continue; fi
    k=${k#"${k%%[!-]*}"}
    if (( i + 1 < ${#t[@]} )) && [[ ${t[i+1]} != --* && ! ${t[i+1]} =~ ^-[A-Za-z] ]]; then
      v=${t[i+1]}; i=$(( i + 1 ))
    else
      v=true
    fi
    printf '%s = %s\n' "$k" "$v"
  done
}

# Entrées du routeur : modèles activés + leurs variantes → E_ID[] E_FILE[] E_CTX[] E_NGL[] E_EXTRA[]
E_ID=() E_FILE=() E_CTX=() E_NGL=() E_EXTRA=()
collect_entries() {
  E_ID=() E_FILE=() E_CTX=() E_NGL=() E_EXTRA=()
  local n v bf bc bn be
  for n in $(model_names); do
    load_model "$n"
    [[ $ENABLED == 1 ]] || continue
    bf=$MODELS_DIR/$n/$FILE bc=$CTX bn=${NGL:-auto} be=$EXTRA
    E_ID+=("$n"); E_FILE+=("$bf"); E_CTX+=("$bc"); E_NGL+=("$bn"); E_EXTRA+=("$be")
    for v in $(variant_names "$n"); do
      load_variant "$n" "$v"
      E_ID+=("$n-$v"); E_FILE+=("$bf")
      E_CTX+=("${V_CTX:-$bc}"); E_NGL+=("${V_NGL:-$bn}"); E_EXTRA+=("$be $V_EXTRA")
    done
  done
}

gen_preset() {
  collect_entries
  mkdir -p "${PRESET_FILE%/*}"
  local i
  {
    echo "; Généré par $PROG — ne pas éditer (voir : $PROG model set|variant …)"
    echo "version = 1"
    echo
    echo "[*]"
    echo "jinja = true"
    echo "parallel = $LLAMA_PARALLEL"
    if (( IDLE_UNLOAD_SECONDS > 0 )); then echo "sleep-idle-seconds = $IDLE_UNLOAD_SECONDS"; fi
    echo
    for i in "${!E_ID[@]}"; do
      echo "[${E_ID[i]}]"
      {
        echo "model = ${E_FILE[i]}"
        echo "ctx-size = ${E_CTX[i]}"
        if [[ ${E_NGL[i]} != auto ]]; then echo "n-gpu-layers = ${E_NGL[i]}"; fi
        extra_to_ini "${E_EXTRA[i]}"
      } | awk -F' = ' '{ k[NR]=$1; l[NR]=$0; last[$1]=NR } END { for (i=1;i<=NR;i++) if (last[k[i]]==i) print l[i] }'
      echo
    done
  } >"$PRESET_FILE.tmp"
  mv "$PRESET_FILE.tmp" "$PRESET_FILE"
}

router_up() { [[ -S $LLAMA_SOCK ]] && curl -fsS -o /dev/null --max-time 2 --unix-socket "$LLAMA_SOCK" http://localhost/health 2>/dev/null; }

apply_preset() { # régénère le preset ; recharge le routeur s'il tourne
  gen_preset
  if router_up; then
    if curl -fsS -o /dev/null --max-time 15 --unix-socket "$LLAMA_SOCK" "http://localhost/models?reload=1"; then
      ok "routeur rechargé (un modèle modifié et chargé est déchargé ; il se recharge à la prochaine requête)"
    else
      warn "rechargement du routeur impossible : $PROG restart llama"
    fi
  fi
}

router_loaded() { # noms des modèles actuellement chargés
  [[ -S $LLAMA_SOCK ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  curl -fsS --max-time 3 --unix-socket "$LLAMA_SOCK" http://localhost/models 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for m in d.get("data", []):
    if (m.get("status") or {}).get("value") == "loaded":
        print(m.get("id", ""))' 2>/dev/null || true
}

model_setup() {
  local pos=() ctx=$DEFAULT_CTX ngl='' extra='' enable=1 effort=''
  while (( $# )); do
    case $1 in
      --ctx)   ctx=${2:?valeur manquante}; shift 2;;
      --ngl)   ngl=${2:?valeur manquante}; shift 2;;
      --extra) extra=${2:?valeur manquante}; shift 2;;
      --effort) effort=${2:?valeur manquante}; shift 2;;
      --no-enable) enable=0; shift;;
      -*) die "option inconnue : $1";;
      *)  pos+=("$1"); shift;;
    esac
  done
  (( ${#pos[@]} >= 2 )) || die "usage : $PROG model setup <nom> <user/repo[:quant] | fichier.gguf> [quant|fichier] [--ctx N] [--ngl N|auto] [--extra \"args llama-server\"] [--effort low|medium|xhigh…] [--no-enable]"
  if [[ -n $effort ]]; then extra="$extra --reasoning-effort $effort"; fi
  local name=${pos[0]} repo=${pos[1]} sel=${pos[2]:-} file rec
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "nom invalide (caractères permis : A-Z a-z 0-9 . _ -)"
  [[ -f $MODELS_CONF/$name.env ]] && die "'$name' existe déjà (voir : $PROG model set|remove $name)"
  check_model_numbers "$ctx" "$ngl"

  if [[ -f $repo ]]; then
    local src; src=$(realpath "$repo")
    file=${src##*/}
    mkdir -p "$MODELS_DIR/$name"
    ln -sfn "$src" "$MODELS_DIR/$name/$file"
    rec="local:$src"
  else
    need curl
    repo=${repo#https://huggingface.co/}; repo=${repo#hf.co/}
    if [[ -z $sel && $repo == *:* ]]; then sel=${repo##*:}; repo=${repo%%:*}; fi
    [[ -n $sel ]] || sel=$DEFAULT_QUANT
    info "Recherche de '$sel' dans $repo"
    resolve_files "$repo" "$sel"
    local f
    for f in "${RESOLVED[@]}"; do
      download "$HF_ENDPOINT/$repo/resolve/main/$f?download=true" "$MODELS_DIR/$name/$f"
    done
    file=${RESOLVED[0]}
    rec=$repo
  fi
  write_model_conf "$name" "$rec" "$file" "$ctx" "$ngl" "$enable" "$extra"
  ok "modèle '$name' configuré (ctx $ctx) → $MODELS_CONF/$name.env"
  apply_preset
}

check_model_numbers() { # ctx ngl
  [[ -z $1 || $1 =~ ^[0-9]+$ ]] || die "--ctx doit être un nombre : $1"
  [[ -z $2 || $2 =~ ^([0-9]+|auto)$ ]] || die "--ngl doit être un nombre ou « auto » : $2"
}

model_set() { # nom [--ctx N] [--ngl N|auto] [--extra "…"] [--add-extra "…"] [--clear-extra]
  local n=${1:?usage : $PROG model set <nom> [--ctx N] [--ngl N|auto] [--extra \"…\"] [--add-extra \"…\"] [--clear-extra]}; shift
  [[ -f $MODELS_CONF/$n.env ]] || die "modèle inconnu : $n"
  (( $# )) || die "rien à modifier (voir : $PROG model show $n)"
  load_model "$n"
  local ctx=$CTX ngl=$NGL extra=$EXTRA
  while (( $# )); do
    case $1 in
      --ctx)         ctx=${2:?valeur manquante}; shift 2;;
      --ngl)         ngl=${2:?valeur manquante}; shift 2;;
      --extra)       extra=${2:?valeur manquante}; shift 2;;
      --add-extra)   extra="$extra ${2:?valeur manquante}"; shift 2;;
      --effort)      extra="$extra --reasoning-effort ${2:?valeur manquante}"; shift 2;;
      --clear-extra) extra=''; shift;;
      *) die "option inconnue : $1";;
    esac
  done
  check_model_numbers "$ctx" "$ngl"
  write_model_conf "$n" "$REPO" "$FILE" "$ctx" "$ngl" "$ENABLED" "$extra"
  ok "'$n' mis à jour (ctx $ctx, ngl ${ngl:-défaut}, extra : ${extra:-aucun})"
  apply_preset
}

model_show() {
  local n=${1:?usage : $PROG model show <nom>} v
  [[ -f $MODELS_CONF/$n.env ]] || die "modèle inconnu : $n"
  load_model "$n"
  printf 'modèle   : %s\nsource   : %s\nfichier  : %s\nctx      : %s\nngl      : %s\nactivé   : %s\nextra    : %s\n' \
    "$n" "$REPO" "$MODELS_DIR/$n/$FILE" "$CTX" "${NGL:-auto}" "$ENABLED" "${EXTRA:-(aucun)}"
  for v in $(variant_names "$n"); do
    load_variant "$n" "$v"
    printf 'variante : %s-%s  (ctx %s, ngl %s, extra : %s)\n' "$n" "$v" "${V_CTX:-hérité}" "${V_NGL:-hérité}" "${V_EXTRA:-(aucun)}"
  done
}

model_variant() { # add|rm|ls
  local sub=${1:-ls}; shift || true
  case $sub in
    add)
      local n=${1:?usage : $PROG model variant add <modèle> <variante> [--effort low|medium|high|…] [--think on|off] [--budget N] [--ctx N] [--ngl N|auto] [--extra \"…\"]}
      local v=${2:?nom de variante requis}; shift 2
      [[ -f $MODELS_CONF/$n.env ]] || die "modèle inconnu : $n"
      [[ $v =~ ^[A-Za-z0-9._-]+$ ]] || die "nom de variante invalide (A-Z a-z 0-9 . _ -)"
      [[ -f $MODELS_CONF/$n-$v.env ]] && die "'$n-$v' existe déjà comme modèle"
      local m; for m in $(model_names); do [[ $m != "$n-$v" ]] || die "'$n-$v' existe déjà comme modèle"; done
      local c='' g='' x=''
      while (( $# )); do
        case $1 in
          --ctx)    c=${2:?}; shift 2;;
          --ngl)    g=${2:?}; shift 2;;
          --extra)  x="$x ${2:?}"; shift 2;;
          --effort) x="$x --reasoning-effort ${2:?}"; shift 2;;
          --budget) x="$x --reasoning-budget ${2:?}"; shift 2;;
          --think)  case ${2:?} in
                      off) x="$x --reasoning-budget 0";;
                      on)  x="$x --reasoning-budget -1";;
                      *)   die "--think : on|off";;
                    esac; shift 2;;
          *) die "option inconnue : $1";;
        esac
      done
      check_model_numbers "$c" "$g"
      mkdir -p "$MODELS_CONF/$n.d"
      { printf 'V_CTX=%q\n' "$c"; printf 'V_NGL=%q\n' "$g"; printf 'V_EXTRA=%q\n' "${x# }"; } >"$MODELS_CONF/$n.d/$v.env"
      ok "variante '$n-$v' créée (même fichier GGUF, aucun téléchargement)"
      apply_preset;;
    rm|remove)
      local n=${1:?usage : $PROG model variant rm <modèle> <variante>} v=${2:?variante requise}
      [[ -f $MODELS_CONF/$n.d/$v.env ]] || die "variante inconnue : $n-$v"
      rm -f "$MODELS_CONF/$n.d/$v.env"
      ok "variante '$n-$v' supprimée"
      apply_preset;;
    ls|list)
      local n v
      for n in $(model_names); do for v in $(variant_names "$n"); do echo "$n-$v"; done; done;;
    *) die "sous-commande inconnue : model variant $sub (add|rm|ls)";;
  esac
}

model_list() {
  local n v fmt='%-26s %-8s %-8s %-8s %-9s %s\n' loaded
  loaded=$(router_loaded)
  printf "$fmt" NOM CTX TAILLE ACTIVÉ ÉTAT SOURCE
  for n in $(model_names); do
    load_model "$n"
    local size=- st=déchargé
    if [[ -e $MODELS_DIR/$n/$FILE ]]; then size=$(du -shL "$MODELS_DIR/$n" 2>/dev/null | cut -f1); else size=ABSENT; fi
    if grep -qx -- "$n" <<<"$loaded"; then st=chargé; fi
    printf "$fmt" "$n" "$CTX" "$size" "$([[ $ENABLED == 1 ]] && echo oui || echo non)" "$st" "$REPO"
    for v in $(variant_names "$n"); do
      load_variant "$n" "$v"
      st=déchargé; if grep -qx -- "$n-$v" <<<"$loaded"; then st=chargé; fi
      printf "$fmt" "  ↳ $n-$v" "${V_CTX:-$CTX}" '' '' "$st" "${V_EXTRA:-}"
    done
  done
  if [[ -z $(model_names) ]]; then
    echo "(aucun modèle — ex : $PROG model setup qwen3-8b unsloth/Qwen3-8B-GGUF Q4_K_M)"
  fi
}

model_files() {
  local repo=${1:?usage : $PROG model files <user/repo>}
  repo=${repo#https://huggingface.co/}; repo=${repo#hf.co/}
  need curl
  list_ggufs "$repo"
}

model_toggle() { # enable|disable name
  local v=1 f
  [[ $1 == disable ]] && v=0
  f=$MODELS_CONF/${2:?nom de modèle requis}.env
  [[ -f $f ]] || die "modèle inconnu : $2"
  sed -E "s/^ENABLED=.*/ENABLED=$v/" "$f" >"$f.tmp" && mv "$f.tmp" "$f"
  ok "$2 : $1"
  apply_preset
}

model_remove() {
  local n=${1:?nom de modèle requis}
  [[ -f $MODELS_CONF/$n.env ]] || die "modèle inconnu : $n"
  confirm "Supprimer le modèle '$n', ses variantes et ses fichiers ?" || return 0
  rm -f "$MODELS_CONF/$n.env"
  rm -rf -- "${MODELS_CONF:?}/$n.d"
  safe_rm "$MODELS_DIR/$n"
  ok "modèle '$n' supprimé"
  apply_preset
}

model_loadunload() { # load|unload [nom]
  local act=$1 n=${2:-} m
  router_up || die "le routeur ne tourne pas : $PROG start llama"
  if [[ -z $n && $act == unload ]]; then
    for m in $(router_loaded); do model_loadunload unload "$m"; done
    return 0
  fi
  [[ -n $n ]] || die "usage : $PROG model $act <nom>"
  curl -fsS --max-time 600 --unix-socket "$LLAMA_SOCK" -X POST -H 'Content-Type: application/json' \
    -d "{\"model\":\"$n\"}" "http://localhost/models/$act" >/dev/null || die "$act '$n' a échoué (voir : $PROG logs llama)"
  ok "$n : $act"
}

cmd_model() {
  load_all
  local sub=${1:-list}; shift || true
  case $sub in
    setup|add)      model_setup "$@";;
    list|ls)        model_list;;
    show)           model_show "$@";;
    set)            model_set "$@";;
    variant|variants) model_variant "$@";;
    files)          model_files "$@";;
    enable|disable) model_toggle "$sub" "${1:-}";;
    remove|rm)      model_remove "${1:-}";;
    load|unload)    model_loadunload "$sub" "${1:-}";;
    *) die "sous-commande inconnue : model $sub (setup|list|show|set|variant|files|enable|disable|remove|load|unload)";;
  esac
}

# ───────────────────────────── llama.cpp (bare metal) ─────────────────────────────
detect_backend() {
  if [[ $LLAMA_BACKEND != auto ]]; then echo "$LLAMA_BACKEND"; return; fi
  if [[ $(uname -s) == Darwin ]]; then echo metal
  elif command -v nvcc >/dev/null 2>&1 || [[ -x /usr/local/cuda/bin/nvcc ]]; then echo cuda
  elif command -v hipcc >/dev/null 2>&1 || [[ -d /opt/rocm ]]; then echo hip
  elif command -v glslc >/dev/null 2>&1 && [[ -n $(ldconfig -p 2>/dev/null | grep libvulkan || true) ]]; then echo vulkan
  else
    if command -v nvidia-smi >/dev/null 2>&1; then
      warn "GPU NVIDIA détecté mais nvcc absent : build CPU. Installe le CUDA toolkit puis : $PROG install --backend cuda"
    fi
    echo cpu
  fi
}

fetch_llama() {
  need git
  if [[ -d $SRC_DIR/.git ]]; then
    git -C "$SRC_DIR" fetch --depth 1 origin "$LLAMA_REF"
    git -C "$SRC_DIR" reset --hard FETCH_HEAD
  else
    git clone --depth 1 --branch "$LLAMA_REF" "$LLAMA_REPO" "$SRC_DIR"
  fi
}

build_llama() {
  local backend jobs args
  backend=$(detect_backend)
  info "Compilation de llama.cpp (backend : $backend)"
  args=(-DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_CURL=OFF)
  case $backend in
    cuda)   args+=(-DGGML_CUDA=ON); [[ -d /usr/local/cuda/bin ]] && PATH="/usr/local/cuda/bin:$PATH";;
    hip)    args+=(-DGGML_HIP=ON);;
    vulkan) args+=(-DGGML_VULKAN=ON);;
    metal)  args+=(-DGGML_METAL=ON);;
    cpu)    ;;
    *) die "backend inconnu : $backend";;
  esac
  # shellcheck disable=SC2206
  args+=($LLAMA_CMAKE_ARGS)
  jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
  cmake -S "$SRC_DIR" -B "$SRC_DIR/build" "${args[@]}"
  cmake --build "$SRC_DIR/build" --config Release --target llama-server -j "$jobs"
  install -Dm755 "$SRC_DIR/build/bin/llama-server" "$BIN_DIR/llama-server"
  echo "$backend" >"$DATA_DIR/backend"
  git -C "$SRC_DIR" rev-parse --short HEAD >"$DATA_DIR/llama.rev"
  ok "llama-server installé ($(<"$DATA_DIR/llama.rev"), $backend)"
  if ! "$BIN_DIR/llama-server" --help 2>&1 | grep -q -- '--models-preset'; then
    warn "ce llama-server ne semble pas avoir le mode routeur (--models-preset) : utilise LLAMA_REF=master"
  fi
}

update_llama() {
  local before after
  before=$(cat "$DATA_DIR/llama.rev" 2>/dev/null || true)
  fetch_llama
  after=$(git -C "$SRC_DIR" rev-parse --short HEAD)
  if [[ $before == "$after" && -x $BIN_DIR/llama-server ]]; then
    ok "llama.cpp déjà à jour ($after)"
  else
    build_llama
  fi
}

# ───────────────────────────── Conteneurs (podman rootless durci) ─────────────────────────────
need_podman() {
  need podman
  [[ $(id -u) -ne 0 ]] || die "podman doit tourner en rootless : ne lance pas ce script en root"
}

ctr_pid() { podman container inspect -f '{{if .State.Running}}{{.State.Pid}}{{end}}' "$1" 2>/dev/null || true; }
ctr_running() { [[ -n $(ctr_pid "$1") ]]; }

stop_ctr() {
  local n=$1
  command -v podman >/dev/null 2>&1 || return 0
  if ctr_running "$n"; then
    podman stop -t 15 "$n" >/dev/null 2>&1 || true
    ok "$n arrêté"
  fi
  podman rm -f "$n" >/dev/null 2>&1 || true
}

ensure_networks() {
  need_podman
  podman network exists "$NET_BACK" 2>/dev/null || podman network create --internal "$NET_BACK" >/dev/null
  podman network exists "$NET_FRONT" 2>/dev/null || podman network create "$NET_FRONT" >/dev/null
}

ENVF=''
cleanup_envfile() { if [[ -n $ENVF ]]; then rm -f -- "$ENVF"; fi; ENVF=''; }
trap cleanup_envfile EXIT
mk_envfile() { # KEY=VAL...
  cleanup_envfile
  ENVF=$(mktemp "${XDG_RUNTIME_DIR:-$RUN_DIR}/llmstack-env.XXXXXX")
  printf '%s\n' "$@" >"$ENVF"
}

own_dir() { # dir uid gid
  local d=$1 u=$2 g=$3 cur
  mkdir -p "$d"
  cur=$(podman unshare stat -c '%u:%g' "$d" 2>/dev/null || true)
  if [[ $cur != "$u:$g" ]]; then
    info "droits de $d → uid $u (podman unshare chown)"
    podman unshare chown -R "$u:$g" "$d" || die "podman unshare a échoué — /etc/subuid et /etc/subgid sont-ils configurés pour $USER ?"
  fi
}

HARDEN=()
harden() { # mémoire pids → HARDEN[]
  HARDEN=(--cap-drop=ALL --security-opt=no-new-privileges --read-only
          --tmpfs "/tmp:rw,nosuid,nodev,size=$TMP_SIZE" --pids-limit "$2")
  if [[ -n $1 ]]; then HARDEN+=(--memory "$1"); fi
}

warn_unpinned() { # image
  local tag=${1##*/}
  [[ $1 != *@sha256:* ]] || return 0
  if [[ $tag != *:* ]] || [[ ${tag##*:} =~ ^(latest|main|main-stable|stable|master)$ ]]; then
    warn "image non épinglée : $1 (fixe une version ou un digest dans stack.env)"
  fi
}

pull_image() { warn_unpinned "$1"; info "Récupération de $1"; podman pull "$1" >/dev/null; ok "$1"; }

setup_searxng_conf() {
  mkdir -p "$CONF_DIR/searxng" "$DATA_DIR/searxng-cache"
  if [[ ! -f $CONF_DIR/searxng/settings.yml ]]; then
    cat >"$CONF_DIR/searxng/settings.yml" <<EOF
# Généré par $PROG — éditable
use_default_settings: true
general:
  instance_name: "llmstack"
  enable_metrics: false
search:
  safe_search: 0
  formats:
    - html
    - json
server:
  secret_key: "$SEARXNG_SECRET"
  limiter: false
  image_proxy: true
EOF
  fi
}

setup_images() { # relay|webui|searxng ...
  need_podman; ensure_networks
  local c
  for c in "$@"; do
    case $c in
      relay)   pull_image "$RELAY_IMAGE";;
      webui)   pull_image "$WEBUI_IMAGE";;
      searxng) if svc_enabled searxng; then setup_searxng_conf; pull_image "$SEARXNG_IMAGE"; fi;;
    esac
  done
}

write_stack_env() {
  local f=$CONF_DIR/stack.env
  [[ -f $f ]] && return 0
  cat >"$f" <<EOF
# llmstack — surcharges (décommenter pour modifier)
#BIND_HOST=$BIND_HOST
#WEBUI_PORT=$WEBUI_PORT
#SEARXNG_PORT=$SEARXNG_PORT
#LLAMA_REF=$LLAMA_REF
#LLAMA_BACKEND=$LLAMA_BACKEND
#LLAMA_CMAKE_ARGS=""
#MODELS_DIR=$MODELS_DIR
#DEFAULT_CTX=$DEFAULT_CTX
#DEFAULT_QUANT=$DEFAULT_QUANT

# ── Routeur llama.cpp
#MODELS_MAX=$MODELS_MAX                    # modèles chargés simultanément (1 = échange automatique)
#MODELS_MEMORY_MARGIN=$MODELS_MEMORY_MARGIN  # MiB de VRAM à garder libres (décharge les plus anciens)
#IDLE_UNLOAD_SECONDS=$IDLE_UNLOAD_SECONDS    # > 0 : mise en veille après N s d'inactivité
#LLAMA_ROUTER_ARGS=""
#LLAMA_PARALLEL=$LLAMA_PARALLEL              # conversations simultanées par modèle

# ── Images : épingle des versions (ou des digests @sha256:...) puis : $PROG update
#WEBUI_IMAGE=$WEBUI_IMAGE
#SEARXNG_IMAGE=$SEARXNG_IMAGE
#RELAY_IMAGE=$RELAY_IMAGE

# ── Sécurité des conteneurs
#SERVICE_UID=$SERVICE_UID
#WEBUI_ENABLE_SIGNUP=$WEBUI_ENABLE_SIGNUP   # False une fois le compte admin créé
#WEBUI_REQUEST_TIMEOUT=$WEBUI_REQUEST_TIMEOUT
#WEBUI_MEMORY=$WEBUI_MEMORY
#WEBUI_PODMAN_ARGS=""
#SEARXNG_PODMAN_ARGS=""

# ── Agent opencode (posé par : $PROG setup-agent)
#OPENCODE_VERSION=$OPENCODE_VERSION         # épingle une version
#MCP_SEARXNG_VERSION=$MCP_SEARXNG_VERSION   # idem pour le serveur MCP SearXNG (Node.js >= 22 requis)
#AGENT_NET=$AGENT_NET                       # 1 = Internet + services locaux (127.0.0.1) accessibles à l'agent ; 0 = réseau coupé
#AGENT_NEW_SESSION=$AGENT_NEW_SESSION
#CODE_EXCLUDES="$CODE_EXCLUDES"
#CODE_COPY_GIT=$CODE_COPY_GIT
EOF
}

cmd_install() {
  load_config
  while (( $# )); do
    case $1 in
      --backend)    LLAMA_BACKEND=${2:?valeur manquante}; shift 2;;
      --ref)        LLAMA_REF=${2:?valeur manquante}; shift 2;;
      --no-searxng) ENABLE_SEARXNG=0; shift;;
      *) die "option inconnue : $1";;
    esac
  done
  [[ $(id -u) -ne 0 ]] || die "ne lance pas ce script en root (sudo n'est appelé que par setup-agent)"
  load_secrets; ensure_dirs; write_stack_env
  if [[ $LLAMA_BACKEND != auto ]]; then set_conf LLAMA_BACKEND "$LLAMA_BACKEND"; fi
  if [[ $LLAMA_REF != master ]]; then set_conf LLAMA_REF "$LLAMA_REF"; fi
  set_conf ENABLE_SEARXNG "$ENABLE_SEARXNG"

  need curl git cmake podman
  command -v c++ >/dev/null 2>&1 || command -v g++ >/dev/null 2>&1 || command -v clang++ >/dev/null 2>&1 \
    || die "compilateur C++ requis (build-essential / xcode-select --install)"

  info "llama.cpp";   fetch_llama; build_llama
  info "Images conteneurs (relais, Open WebUI, SearXNG)"
  setup_images relay webui searxng
  migrate_v2

  echo
  ok "Installation terminée."
  cat <<EOF

  Étapes suivantes :
    $PROG model setup qwen3-8b unsloth/Qwen3-8B-GGUF Q4_K_M
    $PROG start
    → Open WebUI : http://$BIND_HOST:$WEBUI_PORT (le premier compte créé est administrateur)
    $PROG setup-agent     # une fois : prépare opencode (utilisateur dédié + sandbox)
    $PROG code            # puis : opencode sur une copie du dossier courant

  Config : $CONF_DIR
  Clés   : $CONF_DIR/secrets.env
EOF
}

migrate_v2() { # nettoie les restes de la v2 (LiteLLM, un llama-server par modèle)
  local f
  if command -v podman >/dev/null 2>&1; then
    podman rm -f llmstack-litellm >/dev/null 2>&1 || true
  fi
  for f in "$RUN_DIR"/llama-*.pid; do stop_proc "$(basename "$f" .pid)"; done
}

cmd_update() {
  load_all
  local comps=("$@") was=0
  (( ${#comps[@]} )) || comps=(llama webui searxng relay)
  want() { [[ " ${comps[*]} " == *" $1 "* ]]; }
  if any_running; then was=1; fi
  if (( was )); then stop_services; fi
  if want llama;   then info "llama.cpp"; update_llama; fi
  if want relay;   then setup_images relay; fi
  if want webui;   then setup_images webui; fi
  if want searxng && [[ $ENABLE_SEARXNG == 1 ]]; then setup_images searxng; fi
  if want code;    then info "opencode (agent)"; agent_require_setup; agent_install_opencode; agent_ensure_mcp 1; fi
  migrate_v2
  if (( was )); then
    info "Redémarrage de la stack"
    start_services
  fi
  ok "Mise à jour terminée"
}

safe_rm_ns() { # supprime des chemins éventuellement possédés par un subuid
  local p
  for p in "$@"; do
    [[ -n $p && $p != / && $p != "$HOME" && $p == /*/* ]] || die "refus de supprimer '$p'"
    if command -v podman >/dev/null 2>&1; then podman unshare rm -rf -- "$p" || rm -rf -- "$p"; else rm -rf -- "$p"; fi
  done
}

cmd_uninstall() {
  load_all
  local purge=0 c
  [[ ${1:-} == --purge ]] && purge=1
  if (( purge )); then
    confirm "Désinstaller TOUT (logiciels, images, modèles, données Open WebUI, config) ?" || { info "annulé"; return 0; }
  else
    confirm "Désinstaller les logiciels (modèles, données Open WebUI et config conservés) ?" || { info "annulé"; return 0; }
  fi
  stop_services
  if command -v podman >/dev/null 2>&1; then
    for c in "$SEARXNG_CONTAINER" "$CT_WEBUI" "$CT_RELAY" llmstack-litellm; do podman rm -f "$c" >/dev/null 2>&1 || true; done
    for c in "$SEARXNG_IMAGE" "$WEBUI_IMAGE" "$RELAY_IMAGE"; do
      podman rmi "$c" >/dev/null 2>&1 || true
    done
    podman network rm "$NET_BACK" "$NET_FRONT" >/dev/null 2>&1 || true
  fi
  safe_rm "$BIN_DIR" "$SRC_DIR" "$STATE_DIR" "$CACHE_DIR"
  rm -rf -- "$SOCK_DIR"
  rm -f "$DATA_DIR/backend" "$DATA_DIR/llama.rev"
  if (( purge )); then
    safe_rm_ns "$MODELS_DIR" "$DATA_DIR"
    safe_rm "$CONF_DIR"
  fi
  ok "llmstack désinstallé$( (( purge )) || echo ' (données conservées : '"$DATA_DIR"' et '"$CONF_DIR"')')"
  if [[ -n $AGENT_MODE ]]; then info "l'agent opencode reste installé : $PROG setup-agent --remove (avant --purge, sinon la config est perdue)"; fi
}

# ───────────────────────────── Services ─────────────────────────────
wait_sock() { # socket timeout label — rend aussi le socket accessible au relais et à l'agent (autres uid)
  local s=$1 to=$2 label=$3 i
  for (( i = 0; i < to; i++ )); do
    if [[ -S $s ]]; then chmod 666 "$s"; fi
    if [[ -S $s ]] && curl -fsS -o /dev/null --max-time 2 --unix-socket "$s" http://localhost/health 2>/dev/null; then
      ok "$label prêt"; return 0
    fi
    sleep 1
  done
  warn "$label ne répond pas encore sur $s (voir : $PROG logs llama)"
  return 0
}

ctr_http_ok() { # conteneur url — requête exécutée DANS le conteneur
  podman exec "$1" python3 -c 'import sys,urllib.request; urllib.request.urlopen(sys.argv[1], timeout=2)' "$2" >/dev/null 2>&1
}

wait_ctr() { # conteneur timeout label url
  local c=$1 to=$2 label=$3 url=$4 i
  for (( i = 0; i < to; i++ )); do
    if ! ctr_running "$c"; then warn "$label s'est arrêté — voir : $PROG logs ${c#llmstack-}"; return 0; fi
    if ctr_http_ok "$c" "$url"; then ok "$label prêt"; return 0; fi
    sleep 1
  done
  warn "$label ne répond pas encore (voir : $PROG logs ${c#llmstack-})"
  return 0
}

split_args() { # chaîne → SPLIT[]
  SPLIT=()
  if [[ -n $1 ]]; then read -r -a SPLIT <<<"$1"; fi
}

start_searxng() {
  svc_enabled searxng || return 0
  need_podman; ensure_networks
  if ctr_running "$SEARXNG_CONTAINER"; then ok "searxng déjà actif"; return 0; fi
  setup_searxng_conf
  harden "$SEARXNG_MEMORY" "$SEARXNG_PIDS"
  split_args "$SEARXNG_PODMAN_ARGS"
  info "Démarrage de SearXNG"
  podman run -d --replace --name "$SEARXNG_CONTAINER" \
    --userns="$SEARXNG_USERNS" \
    --network "$NET_BACK" --network "$NET_FRONT" \
    -p "127.0.0.1:$SEARXNG_PORT:8080" \
    -v "$CONF_DIR/searxng:/etc/searxng:Z" \
    -v "$DATA_DIR/searxng-cache:/var/cache/searxng:Z" \
    "${HARDEN[@]}" \
    --cap-add=CHOWN --cap-add=SETGID --cap-add=SETUID --cap-add=DAC_OVERRIDE \
    "${SPLIT[@]}" "$SEARXNG_IMAGE" >/dev/null
  wait_ctr "$SEARXNG_CONTAINER" 60 searxng "http://127.0.0.1:8080/healthz"
}
stop_searxng() { stop_ctr "$SEARXNG_CONTAINER"; }

# Routeur llama-server (bare metal) : n'écoute QUE sur un socket unix ; il charge le modèle demandé,
# décharge le précédent si MODELS_MAX est atteint, et lit ses réglages dans le preset généré.
start_router() {
  [[ -x $BIN_DIR/llama-server ]] || die "llama-server absent — lance : $PROG install"
  if [[ -z $(model_names) ]]; then die "aucun modèle — $PROG model setup <nom> <repo-HF> [quant]"; fi
  gen_preset
  if is_running llama && router_up; then ok "routeur llama déjà actif"; return 0; fi
  stop_proc llama
  rm -f "$LLAMA_SOCK"
  local args=(--models-preset "$PRESET_FILE" --models-max "$MODELS_MAX" --host "$LLAMA_SOCK" --no-webui)
  if (( MODELS_MEMORY_MARGIN > 0 )); then args+=(--models-memory-margin "$MODELS_MEMORY_MARGIN"); fi
  split_args "$LLAMA_ROUTER_ARGS"
  info "Démarrage du routeur llama-server (socket $LLAMA_SOCK, $MODELS_MAX modèle(s) max)"
  spawn llama "$DATA_DIR" "$BIN_DIR/llama-server" "${args[@]}" "${SPLIT[@]}"
  wait_sock "$LLAMA_SOCK" 60 "routeur llama"
}

# Seul pont entre le réseau interne et l'hôte : un socat qui ne parle qu'au socket du routeur.
start_relay() {
  need_podman; ensure_networks
  harden "$RELAY_MEMORY" 256
  split_args "$RELAY_PODMAN_ARGS"
  podman run -d --replace --name "$CT_RELAY" \
    --user "$SERVICE_UID:$SERVICE_UID" \
    --network "$NET_BACK" \
    -v "$SOCK_DIR:/socks:ro" \
    "${HARDEN[@]}" "${SPLIT[@]}" \
    --entrypoint /bin/sh "$RELAY_IMAGE" -c "exec socat TCP-LISTEN:$LLAMA_PORT,fork,reuseaddr UNIX-CONNECT:/socks/llama.sock" >/dev/null
  ok "relais llama démarré ($CT_RELAY:$LLAMA_PORT)"
}

start_llama() { start_router; start_relay; }
stop_llama() {
  local f
  for f in "$RUN_DIR"/llama*.pid; do f=${f##*/}; stop_proc "${f%.pid}"; done
  stop_ctr "$CT_RELAY"
  rm -f "$LLAMA_SOCK"
}

start_webui() {
  need_podman; ensure_networks
  if ctr_running "$CT_WEBUI"; then ok "open-webui déjà actif"; return 0; fi
  mkdir -p "$DATA_DIR/webui/home"
  own_dir "$DATA_DIR/webui" "$SERVICE_UID" "$SERVICE_UID"
  local env=(
    "WEBUI_SECRET_KEY=$WEBUI_SECRET_KEY"
    "OPENAI_API_BASE_URL=http://$CT_RELAY:$LLAMA_PORT/v1" "OPENAI_API_KEY=none"
    "AIOHTTP_CLIENT_TIMEOUT=$WEBUI_REQUEST_TIMEOUT"
    ENABLE_OLLAMA_API=False USER_AGENT=llmstack "ENABLE_SIGNUP=$WEBUI_ENABLE_SIGNUP"
    SCARF_NO_ANALYTICS=true DO_NOT_TRACK=true ANONYMIZED_TELEMETRY=false
    HOME=/app/backend/data/home
  )
  if svc_enabled searxng; then
    env+=(
      ENABLE_WEB_SEARCH=True WEB_SEARCH_ENGINE=searxng
      ENABLE_RAG_WEB_SEARCH=True RAG_WEB_SEARCH_ENGINE=searxng
      "SEARXNG_QUERY_URL=http://$SEARXNG_CONTAINER:8080/search?q=<query>"
      RAG_WEB_SEARCH_RESULT_COUNT=5 RAG_WEB_SEARCH_CONCURRENT_REQUESTS=3
    )
  fi
  mk_envfile "${env[@]}"
  harden "$WEBUI_MEMORY" "$WEBUI_PIDS"
  split_args "$WEBUI_PODMAN_ARGS"
  info "Démarrage d'Open WebUI (le premier lancement peut être long)"
  podman run -d --replace --name "$CT_WEBUI" \
    --user "$SERVICE_UID:$SERVICE_UID" \
    --network "$NET_BACK" --network "$NET_FRONT" \
    -p "$BIND_HOST:$WEBUI_PORT:8080" \
    --env-file "$ENVF" \
    -v "$DATA_DIR/webui:/app/backend/data" \
    "${HARDEN[@]}" "${SPLIT[@]}" \
    "$WEBUI_IMAGE" >/dev/null
  cleanup_envfile
  wait_ctr "$CT_WEBUI" 240 open-webui "http://127.0.0.1:8080/health"
}
stop_webui() { stop_ctr "$CT_WEBUI"; }

any_running() {
  local f c
  for f in "$RUN_DIR"/*.pid; do f=${f##*/}; is_running "${f%.pid}" && return 0; done
  command -v podman >/dev/null 2>&1 || return 1
  for c in "$SEARXNG_CONTAINER" "$CT_WEBUI" "$CT_RELAY"; do
    if ctr_running "$c"; then return 0; fi
  done
  return 1
}

TARGETS=()
resolve_targets() {
  local a s want=" ${*:-all} "
  for a in "$@"; do
    [[ $a == all ]] || [[ " ${SERVICES[*]} " == *" $a "* ]] || die "service inconnu : $a (${SERVICES[*]} | all)"
  done
  TARGETS=()
  for s in "${SERVICES[@]}"; do
    svc_enabled "$s" || continue
    if [[ $want == *" all "* || $want == *" $s "* ]]; then TARGETS+=("$s"); fi
  done
}

start_services() {
  local s; resolve_targets "$@"
  for s in "${TARGETS[@]}"; do "start_$s"; done
}
stop_services() {
  local i; resolve_targets "$@"
  for (( i = ${#TARGETS[@]} - 1; i >= 0; i-- )); do "stop_${TARGETS[i]}"; done
}

print_endpoints() {
  echo
  echo "  Open WebUI : http://$BIND_HOST:$WEBUI_PORT"
  echo "  Routeur    : unix:$LLAMA_SOCK  (conteneurs : http://$CT_RELAY:$LLAMA_PORT/v1)"
  if svc_enabled searxng; then echo "  SearXNG    : http://127.0.0.1:$SEARXNG_PORT"; fi
  if [[ -z $AGENT_MODE ]]; then echo "  opencode   : pas encore configuré → $PROG setup-agent"; fi
}

cmd_start()   { load_all; start_services "$@"; print_endpoints; }
cmd_stop()    { load_all; stop_services "$@"; }
cmd_restart() { load_all; stop_services "$@"; start_services "$@"; print_endpoints; }

cmd_status() {
  load_all
  local fmt='%-22s %-8s %-8s %-11s %s\n' pid h loaded
  row() { local st=stoppé; if [[ -n $2 ]]; then st=actif; fi; printf "$fmt" "$1" "$st" "${2:--}" "$3" "$4"; }
  ctr_health() { if [[ -z $(ctr_pid "$1") ]]; then echo -; elif ctr_http_ok "$1" "$2"; then echo ok; else echo démarrage; fi; }
  printf "$fmt" SERVICE ÉTAT PID SANTÉ URL
  if command -v podman >/dev/null 2>&1; then
    if svc_enabled searxng; then
      pid=$(ctr_pid "$SEARXNG_CONTAINER")
      row searxng "$pid" "$(ctr_health "$SEARXNG_CONTAINER" http://127.0.0.1:8080/healthz)" "http://127.0.0.1:$SEARXNG_PORT"
    fi
  fi
  pid=$(pid_of llama); h=-
  if [[ -n $pid ]]; then if router_up; then h=ok; else h=démarrage; fi; fi
  row "llama (routeur)" "$pid" "$h" "unix:$LLAMA_SOCK"
  if command -v podman >/dev/null 2>&1; then
    row relay "$(ctr_pid "$CT_RELAY")" - "$CT_RELAY:$LLAMA_PORT (réseau interne)"
    pid=$(ctr_pid "$CT_WEBUI")
    row webui "$pid" "$(ctr_health "$CT_WEBUI" http://127.0.0.1:8080/health)" "http://$BIND_HOST:$WEBUI_PORT"
  fi
  loaded=$(router_loaded | paste -sd, -)
  echo
  printf 'modèle(s) chargé(s) : %s   (max %s)\n' "${loaded:-aucun}" "$MODELS_MAX"
  printf 'llama.cpp %s (%s)\n' "$(cat "$DATA_DIR/llama.rev" 2>/dev/null || echo '-')" "$(cat "$DATA_DIR/backend" 2>/dev/null || echo '-')"
  printf 'agent    : %s\n' "${AGENT_MODE:-non configuré ($PROG setup-agent)}$([[ -n $AGENT_MODE ]] && echo " (sandbox : $AGENT_SANDBOX)")"
  printf 'images   : webui=%s\n           searxng=%s\n           relay=%s\n' "$WEBUI_IMAGE" "$SEARXNG_IMAGE" "$RELAY_IMAGE"
}

cmd_logs() {
  load_all
  local tgt=${1:?usage : $PROG logs <searxng|webui|relay|llama> [-f]} f ctr=''
  case $tgt in
    searxng) ctr=$SEARXNG_CONTAINER;;
    webui)   ctr=$CT_WEBUI;;
    relay)   ctr=$CT_RELAY;;
  esac
  if [[ -n $ctr ]]; then
    need_podman
    if [[ ${2:-} == -f ]]; then podman logs -f "$ctr"; else podman logs --tail 100 "$ctr"; fi
    return
  fi
  f=$LOG_DIR/$tgt.log
  [[ -f $f ]] || die "pas de log pour '$tgt'"
  if [[ ${2:-} == -f ]]; then tail -n 100 -f "$f"; else tail -n 100 "$f"; fi
}

cmd_bench() { # [modèle] [--sweep ctx1 ctx2 …] — vitesse de génération + mémoire
  load_all
  need python3
  local model='' sweep=() orig_ctx c fill=0
  while (( $# )); do
    case $1 in
      --fill)  fill=${2:?nombre de tokens requis}; [[ $fill =~ ^[0-9]+$ ]] || die "--fill : nombre"; shift 2;;
      --sweep) shift; while (( $# )) && [[ $1 =~ ^[0-9]+$ ]]; do sweep+=("$1"); shift; done;;
      -*) die "option inconnue : $1";;
      *) model=$1; shift;;
    esac
  done
  if [[ -z $model ]]; then model=$(model_names | head -n1); fi
  [[ -n $model ]] || die "aucun modèle configuré"
  router_up || start_router
  bench_once() {
    python3 - "$LLAMA_SOCK" "$model" "$fill" <<'PY'
import http.client, json, socket, sys
sock, model, fill = sys.argv[1], sys.argv[2], int(sys.argv[3])
class C(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(900)
        self.sock.connect(sock)
def ask(prompt, n):
    c = C("localhost")
    c.request("POST", "/v1/chat/completions",
              json.dumps({"model": model, "max_tokens": n, "stream": False,
                          "messages": [{"role": "user", "content": prompt}]}),
              {"Content-Type": "application/json"})
    r = c.getresponse()
    d = json.loads(r.read())
    if r.status != 200:
        sys.exit("erreur HTTP %s : %s" % (r.status, str(d)[:300]))
    return d.get("timings", {})
ask("Dis bonjour.", 8)  # préchauffage : force le chargement du modèle
if fill:
    # conversation longue : on remplit réellement le contexte (la lecture du prompt peut durer plusieurs minutes)
    t = ask("Le chat dort sur le canapé. " * max(1, fill // 9) + "\nRésume ce texte en une phrase.", 96)
else:
    t = ask("Raconte une histoire de 300 mots.", 256)
print("génération : %.1f tokens/s   lecture du prompt : %.0f tokens/s   (prompt %d tokens, %d générés)" % (
    t.get("predicted_per_second", 0), t.get("prompt_per_second", 0), t.get("prompt_n", 0), t.get("predicted_n", 0)))
PY
  }
  if (( ${#sweep[@]} )); then
    [[ -f $MODELS_CONF/$model.env ]] || die "--sweep : donne le modèle de base (pas une variante)"
    load_model "$model"; orig_ctx=$CTX
    for c in "${sweep[@]}"; do
      model_set "$model" --ctx "$c" >/dev/null
      model_loadunload unload >/dev/null 2>&1 || true
      info "contexte $c"
      bench_once
      cmd_mem | grep -E 'VRAM|alloué' | sed 's/^/    /'
    done
    model_set "$model" --ctx "$orig_ctx" >/dev/null
    ok "contexte remis à $orig_ctx"
  else
    info "mesure sur '$model'"
    bench_once
    cmd_mem
  fi
}

cmd_mem() { # où est la mémoire : VRAM, débordement vers la RAM, RAM de llama-server
  load_all
  local d vt vu gt gu name p anon file cmdl role alias any=0
  echo "GPU"
  for d in /sys/class/drm/card*/device; do
    [[ -r $d/mem_info_vram_total ]] || continue
    vt=$(( $(<"$d/mem_info_vram_total") / 1048576 )); vu=$(( $(<"$d/mem_info_vram_used") / 1048576 ))
    gt=$(( $(<"$d/mem_info_gtt_total") / 1048576 ));  gu=$(( $(<"$d/mem_info_gtt_used") / 1048576 ))
    name=${d%/device}; name=${name##*/}
    printf '  %-6s VRAM %6d / %6d Mio   GTT %6d / %6d Mio\n' "$name" "$vu" "$vt" "$gu" "$gt"
    any=1
    if (( vt >= 2048 && gu > 1024 )); then warn "$name : GTT > 1 Gio : une partie de la mémoire du GPU est dans la RAM du PC (sans gravité tant que la conversation reste courte ; ralentit quand le contexte se remplit)"; fi
  done
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null \
      | while IFS=, read -r name vu vt; do printf '  %s VRAM %s / %s Mio\n' "$name" "${vu// /}" "${vt// /}"; done
    any=1
  fi
  if (( ! any )); then echo "  (aucune donnée lisible : il faut le pilote amdgpu ou nvidia-smi)"; fi
  echo "RAM"
  LC_ALL=C free -m | awk '/^Mem:/ { printf "  total %d Mio · utilisée %d · disponible %d\n", $2, $3, $7 }'
  for p in $(pgrep -u "$(id -u)" -f "$BIN_DIR/llama-server" || true); do
    [[ -r /proc/$p/status ]] || continue
    anon=$(awk '/^RssAnon/ { print int($2 / 1024) }' "/proc/$p/status")
    file=$(awk '/^RssFile/ { print int($2 / 1024) }' "/proc/$p/status")
    cmdl=$(tr '\0' ' ' <"/proc/$p/cmdline")
    if [[ $cmdl == *--models-preset* ]]; then
      role=routeur
    else
      alias=$(sed -nE 's/.*--alias ([^ ]+).*/\1/p' <<<"$cmdl")
      role="modèle ${alias:-?}"
    fi
    printf '  pid %-7s %-24s alloué %6d Mio · cache fichier %6d Mio\n' "$p" "$role" "$anon" "$file"
  done
  echo "  « alloué » = vraie mémoire du programme ; « cache fichier » = GGUF mis en cache par Linux (libéré au besoin)"
}

cmd_paths() {
  load_all
  printf 'config : %s\ndonnées: %s\nmodèles: %s\nétat   : %s\ncache  : %s\nsocket : %s\npreset : %s\n' \
    "$CONF_DIR" "$DATA_DIR" "$MODELS_DIR" "$STATE_DIR" "$CACHE_DIR" "$LLAMA_SOCK" "$PRESET_FILE"
  if [[ -n $AGENT_MODE ]]; then printf 'agent  : mode %s · home %s · bin %s · wrapper %s\n' "$AGENT_MODE" "$AGENT_HOME" "$AGENT_BIN" "$WRAPPER"; fi
}

# ───────────────────────────── Agent opencode ─────────────────────────────
# Deux couches :
#   1. utilisateur dédié (AGENT_MODE=user) : l'agent n'a aucun accès à tes fichiers ni à tes secrets ;
#      sudo n'autorise QUE le wrapper (root:root, non modifiable par l'agent).
#   2. sandbox bubblewrap : système en lecture seule, /home et /run masqués, réseau coupé par défaut.
# L'agent travaille sur une COPIE du projet ; les changements reviennent après relecture.

# Wrapper exécuté sous l'utilisateur de l'agent. Embarqué ici, installé par « setup-agent ».
wrapper_text() {
  printf '#!/usr/bin/env bash\nWRAPPER_VERSION=%s\n' "$WRAPPER_VERSION"
  cat <<'WRAP'
# llmstack-agent-run — généré par llmstack, ne pas éditer. Lancé via sudo -u <agent> par llmstack.
set -Eeuo pipefail
umask 022
here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# shellcheck disable=SC1091
source "$here/llmstack-agent.conf"
: "${AGENT_HOME:?}" "${AGENT_BIN:?}"
SANDBOX=${SANDBOX:-bwrap} LLM_PORT=${LLM_PORT:-18080} NEW_SESSION=${NEW_SESSION:-1}
WS_ROOT=$AGENT_HOME/workspace

die() { echo "llmstack-agent: $*" >&2; exit 2; }
key_ok() { [[ ${1:-} =~ ^[A-Za-z0-9._-]{1,100}$ && $1 != . && $1 != .. ]] || die "clé de projet invalide"; }

# Pont local → routeur (socket unix), lancé DANS le sandbox ; opencode ne parle qu'à 127.0.0.1:$LLM_PORT
INNER='socat "TCP-LISTEN:$LLM_PORT,bind=127.0.0.1,fork,reuseaddr" "UNIX-CONNECT:$LLM_SOCK" >/dev/null 2>&1 &
sp=$!
"$@"; rc=$?
kill "$sp" 2>/dev/null || true
exit "$rc"'

AGENT_PATH="$AGENT_BIN/bin:$AGENT_HOME/home/.local/bin:$AGENT_HOME/home/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

BW=()
build_bw() { # workspace net sockdir term colorterm
  local w=$1 net=$2 sockdir=$3 term=$4 cterm=$5 d
  BW=(bwrap --die-with-parent --unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try --cap-drop ALL
      --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /run)
  # on ne masque que ce qui existe : bwrap ne peut pas créer un point de montage sur un système en lecture seule
  for d in /home /root /mnt /media /srv; do
    if [[ -d $d && ! -L $d ]]; then BW+=(--tmpfs "$d"); fi
  done
  BW+=(--ro-bind "$AGENT_BIN" "$AGENT_BIN" --bind "$AGENT_HOME" "$AGENT_HOME")
  if [[ -d $sockdir ]]; then BW+=(--ro-bind "$sockdir" /run/llmstack); fi
  if [[ $net == 1 ]]; then BW+=(--ro-bind-try /run/systemd/resolve /run/systemd/resolve); else BW+=(--unshare-net); fi
  if [[ $NEW_SESSION == 1 ]]; then BW+=(--new-session); fi
  BW+=(--chdir "$w" --clearenv
       --setenv HOME "$AGENT_HOME/home" --setenv PATH "$AGENT_PATH" --setenv TERM "$term"
       --setenv LANG "${LANG:-C.UTF-8}" --setenv USER agent --setenv LOGNAME agent
       --setenv XDG_CONFIG_HOME "$AGENT_HOME/home/.config" --setenv XDG_DATA_HOME "$AGENT_HOME/home/.local/share"
       --setenv XDG_CACHE_HOME "$AGENT_HOME/home/.cache" --setenv XDG_STATE_HOME "$AGENT_HOME/home/.local/state"
       --setenv OPENCODE_CONFIG "$AGENT_HOME/opencode.json" --setenv GIT_TERMINAL_PROMPT 0
       --setenv LLM_SOCK /run/llmstack/llama.sock --setenv LLM_PORT "$LLM_PORT")
  if [[ -n $cterm ]]; then BW+=(--setenv COLORTERM "$cterm"); fi
}

cmd=${1:-}; shift || true
case $cmd in
  version) echo "$WRAPPER_VERSION";;

  import) # tar sur stdin → workspace (remplace l'existant)
    key_ok "${1:-}"; w=$WS_ROOT/$1
    mkdir -p "$WS_ROOT"; rm -rf -- "$w"; mkdir -p "$w"
    tar -x --no-same-owner --no-same-permissions -C "$w" -f -;;

  export) # tar sur stdout : fichiers et dossiers réguliers uniquement (ni liens, ni .git)
    key_ok "${1:-}"; w=$WS_ROOT/$1
    [[ -d $w ]] || die "workspace absent"
    cd "$w"
    find . \( -type f -o -type d \) -not -path './.git' -not -path './.git/*' -print0 \
      | tar -c --null --no-recursion --files-from=- -f -;;

  exists) key_ok "${1:-}"; [[ -d $WS_ROOT/$1 ]];;
  drop)   key_ok "${1:-}"; rm -rf -- "${WS_ROOT:?}/$1";;
  setconf) mkdir -p "$AGENT_HOME"; ( umask 077; cat >"$AGENT_HOME/opencode.json" );;
  resetstate) rm -rf -- "${AGENT_HOME:?}/home"; mkdir -p "$AGENT_HOME/home";;

  selftest) # sockdir
    mkdir -p "$AGENT_HOME/home" "$WS_ROOT/.selftest"
    if [[ $SANDBOX == bwrap ]]; then
      command -v bwrap >/dev/null || die "bwrap introuvable"
      build_bw "$WS_ROOT/.selftest" 0 "${1:-}" xterm ""
      "${BW[@]}" sh -c 'echo sandbox-ok; echo "home visible : $(ls /home 2>/dev/null | wc -l) entrée(s)"; if command -v opencode >/dev/null && opencode --version; then :; else echo "opencode introuvable ou inutilisable"; exit 1; fi'
    else
      echo "sandbox-none"
      if PATH=$AGENT_PATH command -v opencode >/dev/null && PATH=$AGENT_PATH opencode --version; then :; else echo "opencode introuvable ou inutilisable"; exit 1; fi
    fi
    rmdir "$WS_ROOT/.selftest" 2>/dev/null || true;;

  run) # clé net sockdir term colorterm programme [args…]
    key_ok "${1:-}"; w=$WS_ROOT/$1; net=${2:-0}; sockdir=${3:-}; term=${4:-xterm-256color}; cterm=${5:-}
    shift 5 || die "arguments manquants"
    prog=${1:-opencode}
    case $prog in opencode|bash) ;; *) die "programme non autorisé : $prog";; esac
    [[ -d $w ]] || die "workspace absent (importe d'abord le projet)"
    command -v socat >/dev/null || die "socat requis"
    mkdir -p "$AGENT_HOME/home"
    if [[ $SANDBOX == bwrap ]]; then
      command -v bwrap >/dev/null || die "bwrap introuvable"
      build_bw "$w" "$net" "$sockdir" "$term" "$cterm"
      exec "${BW[@]}" sh -c "$INNER" sh "$@"
    else
      cd "$w"
      exec env -i HOME="$AGENT_HOME/home" PATH="$AGENT_PATH" TERM="$term" LANG="${LANG:-C.UTF-8}" \
        XDG_CONFIG_HOME="$AGENT_HOME/home/.config" XDG_DATA_HOME="$AGENT_HOME/home/.local/share" \
        XDG_CACHE_HOME="$AGENT_HOME/home/.cache" XDG_STATE_HOME="$AGENT_HOME/home/.local/state" \
        OPENCODE_CONFIG="$AGENT_HOME/opencode.json" GIT_TERMINAL_PROMPT=0 \
        LLM_SOCK="$sockdir/llama.sock" LLM_PORT="$LLM_PORT" ${cterm:+COLORTERM=$cterm} \
        sh -c "$INNER" sh "$@"
    fi;;

  *) die "sous-commande inconnue : ${cmd:-<vide>}";;
esac
WRAP
}

agent_conf_text() {
  cat <<EOF
AGENT_HOME=$AGENT_HOME
AGENT_BIN=$AGENT_BIN
SANDBOX=$AGENT_SANDBOX
LLM_PORT=$AGENT_LLM_PORT
NEW_SESSION=$AGENT_NEW_SESSION
EOF
}

# Exécute une commande avec les droits requis pour modifier l'installation de l'agent
agent_priv() { if [[ $AGENT_MODE == user ]]; then sudo "$@"; else "$@"; fi; }

# Appelle le wrapper, sous l'utilisateur de l'agent
agent() {
  if [[ $AGENT_MODE == user ]]; then sudo -n -u "$AGENT_USER" -H -- "$WRAPPER" "$@"; else "$WRAPPER" "$@"; fi
}

agent_install_files() {
  local tw tc own=()
  tw=$(mktemp) tc=$(mktemp)
  wrapper_text >"$tw"; agent_conf_text >"$tc"
  if [[ $AGENT_MODE == user ]]; then
    own=(-o root -g root)
    sudo install -d -m 755 "${own[@]}" "$AGENT_BIN" "${WRAPPER%/*}"
  else
    install -d -m 755 "$AGENT_BIN" "${WRAPPER%/*}"
  fi
  agent_priv install -m 755 "${own[@]}" "$tw" "$WRAPPER"
  agent_priv install -m 644 "${own[@]}" "$tc" "${WRAPPER%/*}/llmstack-agent.conf"
  rm -f "$tw" "$tc"
}

NPM_ENV=()
collect_npm_env() { # proxy et certificats à retransmettre à npm lancé sous sudo (qui efface l'environnement)
  NPM_ENV=()
  local v
  for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy NODE_EXTRA_CA_CERTS SSL_CERT_FILE \
           npm_config_registry npm_config_cafile npm_config_strict_ssl npm_config_proxy npm_config_https_proxy; do
    if [[ -n ${!v:-} ]]; then NPM_ENV+=("$v=${!v}"); fi
  done
}

agent_install_opencode() {
  if [[ $OPENCODE_VERSION == latest ]]; then warn "OPENCODE_VERSION=latest : épingle une version dans stack.env"; fi
  info "Installation d'opencode ($OPENCODE_VERSION) dans $AGENT_BIN"
  collect_npm_env
  agent_priv env "${NPM_ENV[@]}" npm install -g --loglevel=error --allow-scripts=opencode-ai --prefix "$AGENT_BIN" "opencode-ai@$OPENCODE_VERSION" >/dev/null
  ok "opencode installé"
}

agent_install_searxng_mcp() { # installe le serveur MCP SearXNG dans le dossier root-owned de l'agent (jamais via npx à l'exécution)
  local major
  major=$(node -p 'parseInt(process.versions.node, 10)')
  if (( major < 22 )); then
    warn "mcp-searxng demande Node.js >= 22 (trouvé : $(node -v)) : recherche web MCP non installée"
    return 0
  fi
  if [[ $MCP_SEARXNG_VERSION == latest ]]; then warn "MCP_SEARXNG_VERSION=latest : épingle une version dans stack.env"; fi
  info "Installation du serveur MCP SearXNG ($MCP_SEARXNG_VERSION) dans $AGENT_BIN"
  collect_npm_env
  agent_priv env "${NPM_ENV[@]}" npm install -g --loglevel=error --prefix "$AGENT_BIN" "mcp-searxng@$MCP_SEARXNG_VERSION" >/dev/null
  ok "serveur MCP SearXNG installé"
}

agent_ensure_opencode() { # reinstall(0|1) — saute l'installation si opencode est déjà présent
  if [[ $1 == 1 || ! -x $AGENT_BIN/bin/opencode ]]; then agent_install_opencode; else ok "opencode déjà installé (--reinstall pour le réinstaller)"; fi
}

agent_ensure_mcp() { # reinstall(0|1) — installe le serveur MCP SearXNG si SearXNG est activé
  [[ $ENABLE_SEARXNG == 1 ]] || return 0
  if [[ $1 == 1 || ! -x $AGENT_BIN/bin/mcp-searxng ]]; then agent_install_searxng_mcp; else ok "serveur MCP SearXNG déjà installé"; fi
}

agent_require_setup() {
  [[ -n $AGENT_MODE ]] || die "l'agent n'est pas configuré : lance d'abord  $PROG setup-agent"
}

agent_require() { # bloque tant que setup-agent n'a pas été fait (et à jour)
  agent_require_setup
  [[ -x $WRAPPER ]] || die "wrapper introuvable ($WRAPPER) : relance  $PROG setup-agent"
  local v
  v=$(agent version 2>/dev/null) || die "impossible de lancer l'agent (sudo / utilisateur $AGENT_USER) : relance  $PROG setup-agent"
  [[ $v == "$WRAPPER_VERSION" ]] || die "wrapper obsolète (v$v, attendu v$WRAPPER_VERSION) : relance  $PROG setup-agent"
}

cmd_setup_agent() {
  load_all
  [[ $(id -u) -ne 0 ]] || die "ne lance pas ce script en root (sudo est appelé seulement quand nécessaire)"
  [[ $(uname -s) == Linux ]] || die "setup-agent : Linux uniquement"
  local mode='' user=$AGENT_USER sandbox=$AGENT_SANDBOX remove=0 reinstall=0 a
  while (( $# )); do
    case $1 in
      --mode)    mode=${2:?valeur manquante}; shift 2;;
      --user)    user=${2:?valeur manquante}; shift 2;;
      --sandbox) sandbox=${2:?valeur manquante}; shift 2;;
      --remove)  remove=1; shift;;
      --reinstall) reinstall=1; shift;;
      *) die "option inconnue : $1";;
    esac
  done
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || die "nom d'utilisateur invalide : $user"
  AGENT_USER=$user
  if (( remove )); then agent_remove; return 0; fi

  if [[ -z $mode ]]; then
    [[ -t 0 ]] || die "précise --mode user|self"
    echo "Où faire tourner opencode ?"
    echo "  1) utilisateur dédié « $user » (recommandé) : séparation de comptes + sandbox ; demande sudo une fois"
    echo "  2) ton utilisateur ($(id -un)) : sandbox seule, l'agent garde tes droits sur ce qui n'est pas masqué"
    read -r -p "Choix [1] : " a
    case ${a:-1} in 1) mode=user;; 2) mode=self;; *) die "choix invalide";; esac
  fi
  case $mode in user|self) ;; *) die "--mode : user|self";; esac
  case $sandbox in bwrap|none) ;; *) die "--sandbox : bwrap|none";; esac

  local miss=() c
  for c in node npm git tar socat; do command -v "$c" >/dev/null 2>&1 || miss+=("$c"); done
  if (( ${#miss[@]} )); then
    die "outils manquants : ${miss[*]}
   Debian/Ubuntu : sudo apt install nodejs npm git socat bubblewrap
   Arch          : sudo pacman -S nodejs npm git socat bubblewrap
   Fedora        : sudo dnf install nodejs npm git socat bubblewrap"
  fi
  if [[ $sandbox == bwrap ]] && ! command -v bwrap >/dev/null 2>&1; then
    warn "bubblewrap absent (apt install bubblewrap · dnf install bubblewrap · pacman -S bubblewrap)"
    confirm "Continuer SANS sandbox (réseau non coupé, système en écriture selon l'utilisateur) ?" || die "installe bubblewrap puis relance"
    sandbox=none
  fi
  if [[ $mode == self && $sandbox == none ]]; then
    confirm "Mode « ton utilisateur » SANS sandbox : l'agent aura tous tes droits. Continuer ?" || die "abandon"
  fi
  local np; np=$(realpath "$(command -v node)")
  if [[ $np == "$HOME"/* ]]; then
    if [[ $mode == user || $sandbox == bwrap ]]; then
      die "node est dans ton HOME ($np) : invisible pour l'agent. Installe node via la distribution (apt/dnf/pacman)."
    fi
    warn "node est dans ton HOME ($np)"
  fi
  command -v git >/dev/null 2>&1 && [[ $(realpath "$(command -v git)") == "$HOME"/* ]] && warn "git est dans ton HOME : invisible pour l'agent en sandbox"

  AGENT_MODE=$mode AGENT_SANDBOX=$sandbox
  agent_paths
  if [[ $mode == user ]]; then
    need sudo
    info "Mode utilisateur dédié « $user » (sudo requis)"
    sudo -v || die "sudo refusé"
    if id -u "$user" >/dev/null 2>&1; then
      ok "l'utilisateur $user existe déjà"
    else
      info "Création de l'utilisateur système $user"
      sudo useradd --system --create-home --home-dir "$AGENT_HOME" --shell /bin/bash --user-group "$user"
    fi
    sudo chmod 700 "$AGENT_HOME"
    sudo -u "$user" mkdir -p "$AGENT_HOME/workspace" "$AGENT_HOME/home"
    local mine; mine=$(id -un)
    local tmp; tmp=$(mktemp)
    printf '# généré par llmstack — %s peut lancer le wrapper de l'"'"'agent sous %s, rien d'"'"'autre\n%s ALL=(%s) NOPASSWD: %s\n' \
      "$mine" "$user" "$mine" "$user" "$WRAPPER" >"$tmp"
    sudo visudo -cf "$tmp" >/dev/null || { rm -f "$tmp"; die "règle sudoers invalide"; }
    agent_install_files
    agent_ensure_opencode "$reinstall"
    agent_ensure_mcp "$reinstall"
    sudo install -m 440 -o root -g root "$tmp" "$SUDOERS_FILE"
    rm -f "$tmp"
    ok "sudoers : $SUDOERS_FILE"
    local perm; perm=$(stat -c %a "$HOME")
    if [[ ${perm: -1} != 0 ]]; then
      warn "ton HOME est en mode $perm : $user pourrait le lire."
      if confirm "chmod o-rwx '$HOME' ?"; then chmod o-rwx "$HOME"; ok "HOME fermé aux autres utilisateurs"; fi
    fi
  else
    info "Mode « ton utilisateur » : installation dans $AGENT_BIN (sans sudo)"
    mkdir -p "$AGENT_HOME/workspace" "$AGENT_HOME/home"
    chmod 700 "$AGENT_HOME"
    agent_install_files
    agent_ensure_opencode "$reinstall"
    agent_ensure_mcp "$reinstall"
  fi

  set_conf AGENT_MODE "$mode"; set_conf AGENT_USER "$user"; set_conf AGENT_SANDBOX "$sandbox"
  if [[ $OPENCODE_VERSION != latest ]]; then set_conf OPENCODE_VERSION "$OPENCODE_VERSION"; fi

  info "Vérification"
  local out
  if ! out=$(agent selftest "$SOCK_DIR" 2>&1); then
    printf '%s\n' "$out" >&2
    if [[ $out == *sandbox-ok* || $out == *sandbox-none* ]]; then
      warn "le sandbox fonctionne mais opencode est inutilisable (script d'installation bloqué par npm ?)."
      warn "Relance : $PROG setup-agent --mode $mode --reinstall"
    else
      warn "le test du sandbox a échoué. Causes fréquentes : user namespaces non privilégiés désactivés"
      warn "(Ubuntu 24.04+ : profil AppArmor pour bwrap ; Debian : sysctl kernel.unprivileged_userns_clone=1)."
      warn "Relance ensuite : $PROG setup-agent --mode $mode   (ou --sandbox none, déconseillé)"
    fi
    die "setup-agent incomplet"
  fi
  printf '%s\n' "$out" | sed 's/^/    /'
  ok "agent prêt (mode $mode, sandbox $sandbox) — lance : $PROG code"
}

agent_remove() {
  [[ -n $AGENT_MODE ]] || die "aucun agent configuré"
  confirm "Retirer l'agent opencode (wrapper, sudoers, binaire opencode) ?" || { info "annulé"; return 0; }
  if [[ $AGENT_MODE == user ]]; then
    sudo -v || die "sudo refusé"
    sudo rm -f "$SUDOERS_FILE" "$WRAPPER" "${WRAPPER%/*}/llmstack-agent.conf"
    sudo rm -rf -- "$AGENT_BIN"
    if confirm "Supprimer aussi l'utilisateur $AGENT_USER et son home (workspaces, sessions, auth) ?"; then
      sudo userdel -r "$AGENT_USER" 2>/dev/null || warn "userdel a échoué (processus en cours ?)"
    fi
  else
    rm -rf -- "$AGENT_BIN"
    if confirm "Supprimer aussi $AGENT_HOME (workspaces, sessions) ?"; then rm -rf -- "$AGENT_HOME"; fi
  fi
  rm -rf -- "$CODE_STATE"; mkdir -p "$CODE_STATE"
  unset_conf AGENT_MODE; unset_conf AGENT_USER; unset_conf AGENT_SANDBOX
  ok "agent retiré"
}

# ── Copie du projet, diff, application ──

code_key() { # dir → clé stable (nom + hash du chemin)
  local base; base=$(basename -- "$1" | tr -c 'A-Za-z0-9._\n-' '_')
  printf '%s-%s' "${base:0:40}" "$(printf %s "$1" | sha256sum | cut -c1-8)"
}

code_check_dir() { # refuse de copier un répertoire sensible (ou parent d'un répertoire sensible)
  local p=$1 d
  [[ $p != / && $p != "$HOME" ]] || die "refus de copier '$p' : choisis un répertoire de projet"
  for d in "$CONF_DIR" "$DATA_DIR" "$STATE_DIR" "$SOCK_DIR" "$HOME/.ssh" "$HOME/.gnupg" "$HOME/.aws"; do
    if [[ $p/ == "$d"/* || $d/ == "$p"/* ]]; then die "refus de copier '$p' (contient ou est dans $d)"; fi
  done
}

code_write_excludes() { # → $CODE_STATE/excludes (utilisé par tar et rsync)
  local f=$CODE_STATE/excludes p
  { for p in $CODE_EXCLUDES; do echo "$p"; done
    echo ".git/hooks"; echo ".git/config"
    if [[ $CODE_COPY_GIT != 1 ]]; then echo ".git"; fi
  } >"$f"
  EXF=$f
}

code_import() { # proj key meta
  local proj=$1 key=$2 meta=$3 mb
  code_write_excludes
  mb=$(du -sm -- "$proj" 2>/dev/null | cut -f1 || echo 0)
  if (( mb > CODE_MAX_COPY_MB )); then
    confirm "'$proj' fait ${mb} Mo (limite CODE_MAX_COPY_MB=$CODE_MAX_COPY_MB). Copier quand même ?" || die "abandon"
  fi
  mkdir -p "$meta"
  info "Copie de $proj vers l'espace de l'agent (${mb} Mo)"
  tar -C "$proj" -c --exclude-from="$EXF" -f "$meta/in.tar" .
  rm -rf -- "$meta/base" "$meta/new"; mkdir -p "$meta/base"
  tar -x --no-same-owner -C "$meta/base" -f "$meta/in.tar"
  find "$meta/base" -type l -delete
  agent import "$key" <"$meta/in.tar"
  rm -f "$meta/in.tar"
  printf '%s\n' "$proj" >"$meta/path"
  : >"$meta/pending"
}

CH_T=() CH_P=() CH_S=()
code_collect() { # meta key → remplit CH_T/CH_P (type A|M|D, chemin) ; relève l'état de l'agent
  local meta=$1 key=$2 raw l fl p
  code_write_excludes
  rm -rf -- "$meta/new"; mkdir -p "$meta/new"
  agent export "$key" | tar -x --no-same-owner --no-same-permissions -C "$meta/new" -f - || die "export du workspace impossible"
  find "$meta/new" -type l -delete
  raw=$(rsync -rpcn --delete --exclude=/.git --exclude-from="$EXF" --out-format='%i|%n' "$meta/new/" "$meta/base/" || true)
  CH_T=() CH_P=()
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    fl=${l%%|*} p=${l#*|}
    [[ $p != */ ]] || continue          # dossiers : ignorés (créés/supprimés avec leurs fichiers)
    case $fl in
      '*deleting'*) CH_T+=(D); CH_P+=("$p");;
      '>f+++++++++') CH_T+=(A); CH_P+=("$p");;
      '>f'*)         CH_T+=(M); CH_P+=("$p");;
    esac
  done <<<"$raw"
}

code_sensitive() { # chemin relatif, fichier → 0 si exécutable/déclencheur au prochain usage
  case $1 in
    package.json|*/package.json|Makefile|*/Makefile|makefile|GNUmakefile|justfile|Taskfile*|.envrc|*/.envrc|*.sh|\
    .husky/*|*/.husky/*|.github/*|.gitlab-ci.yml|.vscode/*|.idea/*|Dockerfile*|docker-compose*|compose.y*ml|\
    setup.py|pyproject.toml|build.rs|Cargo.toml|conftest.py|.pre-commit-config.yaml|.gitattributes|.gitmodules|\
    .bashrc|.zshrc|.profile|*.service|noxfile.py|tox.ini|build.gradle*|pom.xml) return 0;;
  esac
  [[ -f $2 && -x $2 ]]
}

code_safe_path() { # proj relpath → 0 si le chemin résolu reste dans proj (aucun lien traversé)
  local proj=$1 p=$2 d
  case $p in /*|..|../*|*/../*|*/..) return 1;; esac
  if [[ $p == */* ]]; then d=$proj/${p%/*}; else d=$proj; fi
  while [[ ! -e $d && $d != "$proj" ]]; do d=${d%/*}; done
  d=$(realpath -e -- "$d") || return 1
  [[ $d == "$proj" || $d == "$proj"/* ]]
}

code_plan() { # meta proj → CH_S[] : ok | noop | conflict
  local meta=$1 proj=$2 i st t p base new tgt
  CH_S=()
  for i in "${!CH_P[@]}"; do
    t=${CH_T[i]} p=${CH_P[i]} st=ok
    base=$meta/base/$p new=$meta/new/$p tgt=$proj/$p
    case $t in
      A) if [[ -e $tgt || -L $tgt ]]; then
           if [[ ! -L $tgt ]] && cmp -s "$new" "$tgt"; then st=noop; else st=conflict; fi
         fi;;
      M) if [[ -L $tgt || ! -f $tgt ]]; then st=conflict
         elif cmp -s "$new" "$tgt"; then st=noop
         elif ! cmp -s "$base" "$tgt"; then st=conflict; fi;;
      D) if [[ ! -e $tgt && ! -L $tgt ]]; then st=noop
         elif [[ -L $tgt ]] || ! cmp -s "$base" "$tgt"; then st=conflict; fi;;
    esac
    CH_S+=("$st")
  done
}

code_summary() { # meta
  local meta=$1 i n=0 nc=0 ns=0 mark sym
  for i in "${!CH_P[@]}"; do
    [[ ${CH_S[i]} != noop ]] || continue
    n=$(( n + 1 ))
    case ${CH_T[i]} in A) sym="${C_G}+${C_0}";; M) sym="${C_Y}~${C_0}";; D) sym="${C_R}-${C_0}";; esac
    mark=''
    if [[ ${CH_S[i]} == conflict ]]; then mark=" ${C_R}[CONFLIT : modifié dans ton projet depuis la copie]${C_0}"; nc=$(( nc + 1 )); fi
    if [[ ${CH_T[i]} != D ]] && code_sensitive "${CH_P[i]}" "$meta/new/${CH_P[i]}"; then mark+=" ${C_Y}[⚠ exécutable/déclencheur : relis-le]${C_0}"; ns=$(( ns + 1 )); fi
    if (( n <= 200 )); then printf '  %s %s%s\n' "$sym" "${CH_P[i]}" "$mark"; fi
  done
  if (( n > 200 )); then echo "  … et $(( n - 200 )) autres"; fi
  printf '%s changement(s)' "$n"
  if (( nc )); then printf ', %s conflit(s)' "$nc"; fi
  if (( ns )); then printf ', %s fichier(s) sensible(s)' "$ns"; fi
  echo
  CH_COUNT=$n CH_CONF=$nc CH_SENS=$ns
}

CH_COUNT=0 CH_CONF=0 CH_SENS=0
code_pager() { if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then less -RFX; else cat; fi; }

code_show_diff() { # meta
  local meta=$1 i p col=never
  if [[ -t 1 ]]; then col=always; fi
  {
    for i in "${!CH_P[@]}"; do
      [[ ${CH_S[i]} != noop ]] || continue
      p=${CH_P[i]}
      case ${CH_T[i]} in
        A) diff -u --color="$col" --label /dev/null --label "b/$p" /dev/null "$meta/new/$p" || true;;
        M) diff -u --color="$col" --label "a/$p" --label "b/$p" "$meta/base/$p" "$meta/new/$p" || true;;
        D) diff -u --color="$col" --label "a/$p" --label /dev/null "$meta/base/$p" /dev/null || true;;
      esac
    done
  } | code_pager
}

code_apply() { # meta proj key force → applique les changements OK (et les conflits si force)
  local meta=$1 proj=$2 key=$3 force=$4 i t p st new tgt d skipped=0 done_n=0 mode
  for i in "${!CH_P[@]}"; do
    t=${CH_T[i]} p=${CH_P[i]} st=${CH_S[i]}
    new=$meta/new/$p tgt=$proj/$p
    [[ $st != noop ]] || continue
    if [[ $st == conflict && $force != 1 ]]; then warn "conflit, ignoré : $p"; skipped=$(( skipped + 1 )); continue; fi
    if [[ -L $tgt ]] || ! code_safe_path "$proj" "$p"; then warn "chemin non sûr (lien symbolique), ignoré : $p"; skipped=$(( skipped + 1 )); continue; fi
    case $t in
      A) if [[ -x $new ]]; then mode=755; else mode=644; fi
         install -D -m "$mode" "$new" "$tgt";;
      M) cp --no-preserve=mode -- "$new" "$tgt"
         if [[ -x $new && ! -x $tgt ]]; then chmod u+x,g+x "$tgt"; fi
         if [[ ! -x $new && -x $tgt ]]; then chmod a-x "$tgt"; fi;;
      D) rm -f -- "$tgt"
         d=$p
         while [[ $d == */* ]]; do
           d=${d%/*}
           rmdir -- "$proj/$d" 2>/dev/null || break
         done;;
    esac
    done_n=$(( done_n + 1 ))
  done
  ok "$done_n fichier(s) appliqué(s)$( (( skipped )) && echo ", $skipped ignoré(s)")"
  if (( skipped == 0 )); then
    agent drop "$key"; rm -rf -- "$meta"
    info "session terminée (workspace supprimé)"
  else
    info "session conservée : $PROG code diff · apply --force · discard"
  fi
}

code_review() { # meta proj key  — après la session : résumé + choix
  local meta=$1 proj=$2 key=$3 ans
  code_collect "$meta" "$key"
  code_plan "$meta" "$proj"
  code_summary "$meta"
  if (( CH_COUNT == 0 )); then
    info "aucun changement à rapatrier"
    agent drop "$key"; rm -rf -- "$meta"
    return 0
  fi
  if [[ ! -t 0 || $ASSUME_YES == 1 ]]; then
    info "à relire puis : $PROG code diff · $PROG code apply · $PROG code discard   (dans $proj)"
    return 0
  fi
  while true; do
    read -r -p "[a]ppliquer  [d]iff  [l]aisser pour plus tard  [x] abandonner > " ans || ans=l
    case $ans in
      a|A) if (( CH_SENS )) && ! confirm "Des fichiers exécutables/déclencheurs sont modifiés. Les as-tu relus ?"; then continue; fi
           code_apply "$meta" "$proj" "$key" 0; return 0;;
      d|D) code_show_diff "$meta";;
      x|X) if confirm "Abandonner TOUS les changements de l'agent ?"; then agent drop "$key"; rm -rf -- "$meta"; ok "abandonné"; return 0; fi;;
      l|L|'') info "conservé : $PROG code diff · apply · discard"; return 0;;
    esac
  done
}

CODE_CONF=''
code_write_config() { # net(0|1) → $CODE_STATE/opencode.json (ou ton $CONF_DIR/opencode.json) puis envoyé à l'agent
  local net=$1 f=$CODE_STATE/opencode.json i first='' sep='' models='' mcp=''
  CODE_CONF=$f
  if [[ -f $CONF_DIR/opencode.json ]]; then
    CODE_CONF=$CONF_DIR/opencode.json
  else
    collect_entries
    (( ${#E_ID[@]} )) || die "aucun modèle activé — $PROG model setup <nom> <repo-HF> [quant]"
    local out
    for i in "${!E_ID[@]}"; do
      [[ -n $first ]] || first=${E_ID[i]}
      out=$(( E_CTX[i] / 4 ))
      if (( out > 16384 )); then out=16384; fi
      models+="$sep"$'\n'"        \"${E_ID[i]}\": { \"name\": \"${E_ID[i]}\", \"limit\": { \"context\": ${E_CTX[i]}, \"output\": $out } }"
      sep=,
    done
    if [[ $net == 1 && $ENABLE_SEARXNG == 1 && -x $AGENT_BIN/bin/mcp-searxng ]]; then
      mcp=$(cat <<MCP
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["$AGENT_BIN/bin/mcp-searxng"],
      "environment": { "SEARXNG_URL": "http://127.0.0.1:$SEARXNG_PORT" },
      "enabled": true,
      "timeout": 15000
    }
  },
MCP
)
    fi
    # small_model = le même : évite qu'opencode appelle un autre modèle (→ échange de modèle) pour les titres
    cat >"$f" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "llmstack/$first",
  "small_model": "llmstack/$first",
$mcp
  "provider": {
    "llmstack": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llmstack",
      "options": {
        "baseURL": "http://127.0.0.1:$AGENT_LLM_PORT/v1",
        "apiKey": "none"
      },
      "models": {$models
      }
    }
  }
}
EOF
  fi
  agent setconf <"$CODE_CONF"
}

code_status() {
  local d p n=0
  for d in "$CODE_STATE"/*/; do
    [[ -f $d/pending ]] || continue
    p=$(<"$d/path")
    printf '  en cours : %s\n' "$p"
    n=$(( n + 1 ))
  done
  if (( n == 0 )); then echo "aucune session en attente"; fi
}

cmd_code() { # [--net|--offline] [build|shell|diff|apply|discard|status|reset] [dir] [-- args opencode]
  load_all
  local net=$AGENT_NET sub=run force=0 dir=$PWD proj key meta oc=() prog=opencode ans
  while (( $# )); do
    case $1 in
      --net)     net=1; shift;;
      --offline) net=0; shift;;
      --force)   force=1; shift;;
      build|update) sub=update; shift;;
      shell|diff|apply|discard|status|reset) sub=$1; shift;;
      *) break;;
    esac
  done
  agent_require     # bloque tant que « setup-agent » n'a pas été fait
  case $sub in
    update) agent_install_opencode; agent_ensure_mcp 1; return 0;;
    status) code_status; return 0;;
    reset)  confirm "Effacer l'état d'opencode (sessions, auth) ?" || return 0
            agent resetstate; ok "état d'opencode effacé"; return 0;;
  esac
  if (( $# )) && [[ $1 != -* && -d $1 ]]; then dir=$1; shift; fi
  if [[ ${1:-} == -- ]]; then shift; fi
  oc=("$@")
  proj=$(realpath -- "$dir")
  code_check_dir "$proj"
  key=$(code_key "$proj")
  meta=$CODE_STATE/$key

  case $sub in
    diff|apply|discard)
      [[ -f $meta/pending ]] || die "aucune session en attente pour $proj"
      if [[ $sub == discard ]]; then
        confirm "Abandonner les changements de l'agent pour $proj ?" || return 0
        agent drop "$key"; rm -rf -- "$meta"; ok "abandonné"; return 0
      fi
      code_collect "$meta" "$key"; code_plan "$meta" "$proj"; code_summary "$meta"
      (( CH_COUNT )) || { info "rien à rapatrier"; return 0; }
      if [[ $sub == diff ]]; then code_show_diff "$meta"; return 0; fi
      if (( CH_SENS )) && ! confirm "Des fichiers exécutables/déclencheurs sont modifiés. Les as-tu relus ?"; then return 0; fi
      if (( CH_CONF && force )); then confirm "--force écrasera tes modifications récentes sur les fichiers en conflit. Continuer ?" || return 0; fi
      code_apply "$meta" "$proj" "$key" "$force"
      return 0;;
  esac

  # run | shell
  if [[ $sub == shell ]]; then prog=bash; fi
  if [[ -f $meta/pending ]] && agent exists "$key" 2>/dev/null; then
    info "une session précédente a des changements non appliqués pour $proj"
    ans=r
    if [[ -t 0 && $ASSUME_YES == 0 ]]; then
      read -r -p "[r]eprendre le workspace  [a]ppliquer/relire d'abord  [n]ouvelle copie (perd ces changements)  [x] annuler > " ans || ans=x
    fi
    case $ans in
      r|R|'') ;;
      a|A) code_review "$meta" "$proj" "$key"; [[ -f $meta/pending ]] && return 0;;
      n|N) confirm "Écraser le workspace de l'agent (changements non appliqués perdus) ?" || return 0
           code_import "$proj" "$key" "$meta";;
      *) return 0;;
    esac
  else
    code_import "$proj" "$key" "$meta"
  fi
  agent exists "$key" || code_import "$proj" "$key" "$meta"

  if ! router_up; then
    info "routeur llama arrêté : démarrage"
    start_router
  fi
  if [[ $net == 1 && $ENABLE_SEARXNG == 1 ]] && command -v podman >/dev/null 2>&1 && ! ctr_running "$SEARXNG_CONTAINER"; then
    if ! ( start_searxng ); then warn "SearXNG n'a pas démarré : la recherche web sera indisponible"; fi
  fi
  code_write_config "$net"

  info "opencode (agent $AGENT_MODE, sandbox $AGENT_SANDBOX, réseau $([[ $net == 1 ]] && echo 'ouvert' || echo 'coupé')) — copie de $proj"
  local rc=0
  agent run "$key" "$net" "$SOCK_DIR" "${TERM:-xterm-256color}" "${COLORTERM:-}" "$prog" "${oc[@]}" || rc=$?
  echo
  code_review "$meta" "$proj" "$key"
  return "$rc"
}

usage() {
  cat <<EOF
$PROG $VERSION — pile LLM locale (llama.cpp routeur · Open WebUI · SearXNG · opencode)

Usage : $PROG [-y] <commande> [args]

  install [--backend auto|cuda|hip|vulkan|metal|cpu] [--ref <tag|branche>] [--no-searxng]
  update  [llama|webui|searxng|relay|code ...]   met à jour (défaut : sans code)
  start   [searxng|llama|webui ...]              (défaut : tout)
  stop    [...]
  restart [...]
  status
  logs    <searxng|webui|relay|llama> [-f]
  uninstall [--purge]                            --purge : supprime aussi modèles, données et config
  paths
  mem                                            VRAM, débordement vers la RAM, RAM de llama-server
  bench [modèle] [--fill N] [--sweep ctx1 ctx2 …]  vitesse (tokens/s) + mémoire ; --fill N : avec ~N tokens déjà dans la conversation ;
                                                 --sweep : essaie plusieurs contextes

  model setup <nom> <user/repo[:quant] | fichier.gguf> [quant|fichier] [--ctx N] [--ngl N|auto] [--extra "args llama-server"] [--effort low|medium|xhigh] [--no-enable]
  model list | show <nom> | files <user/repo>
  model set <nom> [--ctx N] [--ngl N|auto] [--extra "…"] [--add-extra "…"] [--effort L] [--clear-extra]
                                                 change les réglages sans retélécharger (rechargé à chaud)
  model variant add <modèle> <variante> [--effort low|medium|high] [--think on|off] [--budget N]
                                        [--ctx N] [--ngl N|auto] [--extra "…"]
  model variant rm <modèle> <variante> | ls     variantes = mêmes poids, autres réglages (modèle « <nom>-<variante> »)
  model enable|disable|remove <nom>
  model load|unload [nom]                        charge/décharge à la main (unload sans nom : tout)

  setup-agent [--mode user|self] [--user NOM] [--sandbox bwrap|none] [--reinstall] [--remove]
                                                 prépare opencode (obligatoire avant « code »)
  code    [--offline] [dir] [-- args opencode]   opencode sur une COPIE de dir (défaut : .), diff à la sortie ; réseau ouvert par défaut
  code diff | apply [--force] | discard [dir]    relire / rapatrier / abandonner les changements de l'agent
  code shell [dir] | status | reset | update     shell dans le sandbox · sessions en attente · efface l'état · met à jour opencode et le serveur MCP SearXNG

Options globales : -y|--yes (pas de confirmation)    Variable : HF_TOKEN (dépôts privés)
Surcharges : \${XDG_CONFIG_HOME:-~/.config}/llmstack/stack.env
EOF
}

main() {
  local args=() a
  for a in "$@"; do
    case $a in -y|--yes) ASSUME_YES=1;; *) args+=("$a");; esac
  done
  set -- "${args[@]}"
  local cmd=${1:-help}; shift || true
  case $cmd in
    install)   cmd_install "$@";;
    update|upgrade) cmd_update "$@";;
    start)     cmd_start "$@";;
    stop)      cmd_stop "$@";;
    restart)   cmd_restart "$@";;
    status)    cmd_status;;
    logs)      cmd_logs "$@";;
    uninstall) cmd_uninstall "$@";;
    model)     cmd_model "$@";;
    models)    cmd_model list;;
    paths)     cmd_paths;;
    mem)       cmd_mem;;
    bench)     cmd_bench "$@";;
    setup-agent) cmd_setup_agent "$@";;
    code)      cmd_code "$@";;
    -V|--version) echo "$VERSION";;
    help|-h|--help) usage;;
    *) usage >&2; exit 1;;
  esac
}

main "$@"
